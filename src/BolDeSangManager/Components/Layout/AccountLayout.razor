@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Default" Dense="true">
        <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" Class="ml-1 text-transform-none px-2">
            <MudText Typo="Typo.h6"><b>BolDeSang Manager</b></MudText>
        </MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 px-2 px-sm-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#e53935",
            PrimaryDarken = "#b71c1c",
            PrimaryLighten = "#ef5350",
            Secondary = "#78909c",
            AppbarBackground = "#1c1c1c",
            AppbarText = "rgba(255,255,255,0.87)",
            Background = "#111111",
            Surface = "#1e1e1e",
            TextPrimary = "rgba(255,255,255,0.87)",
            TextSecondary = "rgba(255,255,255,0.6)",
        }
    };
}
