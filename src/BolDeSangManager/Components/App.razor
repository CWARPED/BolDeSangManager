<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BolDeSangManager.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="@PageRenderMode" />
    <title>BolDeSang Manager</title>
</head>

<body>
    <Routes @rendermode="@PageRenderMode" />

    <!-- Modale de reconnexion du circuit Blazor. Les classes CSS
         components-reconnect-* sont posées par le framework (voir app.css). -->
    <div id="components-reconnect-modal">
        <div class="reconnect-box">
            <div class="reconnect-spinner"></div>
            <p class="reconnect-titre">Connexion perdue</p>
            <p class="reconnect-detail">
                Tentative de reconnexion
                <span class="reconnect-compteur">
                    <span id="components-reconnect-current-attempt"></span>/<span id="components-reconnect-max-retries"></span>
                </span>…
            </p>
            <p class="reconnect-aide">
                Ne fermez pas cette page&nbsp;: votre saisie en cours est conservée
                sur le serveur pendant quelques minutes.
            </p>
            <button id="reconnect-retry-button" type="button">Réessayer</button>
        </div>
    </div>

    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="@Assets["reconnect.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        window.clickElement = id => { const el = document.getElementById(id); if (el) el.click(); };
        window.getBrowserInfo = function () {
            const ua = navigator.userAgent;
            const m = ua.match(/(Edg|OPR|Chrome|Firefox|Safari)\/(\d+)/);
            if (!m) return 'Inconnu';
            const map = { Edg: 'Edge', OPR: 'Opera', Chrome: 'Chrome', Firefox: 'Firefox', Safari: 'Safari' };
            return map[m[1]] + ' ' + m[2];
        };
        window.blazorDownloadBase64File = function (filename, mimeType, base64) {
            const chars = atob(base64);
            const bytes = new Uint8Array(chars.length);
            for (let i = 0; i < chars.length; i++) bytes[i] = chars.charCodeAt(i);
            const blob = new Blob([bytes], { type: mimeType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = filename;
            document.body.appendChild(a); a.click();
            document.body.removeChild(a);
            // ⚠️ NE PAS révoquer l'URL immédiatement : Firefox lit le blob de façon
            // ASYNCHRONE après le clic. Révoquer tout de suite détruit la source
            // avant qu'il ait fini, et le fichier téléchargé est tronqué ou vide —
            // symptôme observé : « impossible d'ouvrir le PDF » sous Firefox alors
            // que Chrome, qui lit de façon synchrone, ne voyait rien.
            setTimeout(() => URL.revokeObjectURL(url), 60000);
        };
    </script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Active le rendermode interactif uniquement pour les pages qui n'ont pas [ExcludeFromInteractiveRouting].
    // Les pages Account d'Identity restent en SSR statique (nécessaire pour les form posts).
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
