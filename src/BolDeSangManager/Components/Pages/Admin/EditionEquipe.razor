@page "/admin/donnees/equipes/{IdParam}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,GrandCommissaire")]
@using BolDeSangManager.Data.Models
@using BolDeSangManager.Data.Enums
@using BolDeSangManager.Services
@inject DataEditService DataEditService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Édition équipe</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h4">@(IsNew ? "Nouvelle équipe" : "Édition équipe")</MudText>
        <MudButton OnClick="Retour">Retour</MudButton>
    </MudStack>

    @if (_team is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_team.Nom" Label="Nom" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" sm="3">
                    @* Catégorie officielle LRB (p.94), purement informative.
                       0 = non renseignée : les commissaires font la passe de saisie.
                       Placeholder : sans lui MudBlazor ne fait pas remonter le
                       libellé quand la valeur vaut le défaut du type (0), et le
                       libellé se superpose au texte affiché. *@
                    <MudSelect T="int" @bind-Value="_team.Categorie" Label="Catégorie (LRB)"
                               Variant="Variant.Outlined" Placeholder=" ">
                        <MudSelectItem Value="0">Non renseignée</MudSelectItem>
                        <MudSelectItem Value="1">1 — les plus performantes</MudSelectItem>
                        <MudSelectItem Value="2">2 — solides</MudSelectItem>
                        <MudSelectItem Value="3">3 — plus délicates à jouer</MudSelectItem>
                        <MudSelectItem Value="4">4 — les plus faibles</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3"><MudNumericField @bind-Value="_team.CoutRelance" Label="Coût relance" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_team.ReglesSpeciales" Label="Règles spéciales (texte libre)" Variant="Variant.Outlined" Lines="2" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_team.ReglesSpecialesLigue" Label="Règles ligues thématiques (CSV)" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SauvegarderEquipe">
                        Sauvegarder
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* ── Règles spéciales ───────────────────────────────────────────────
           On n'affiche QUE les règles rattachées à l'équipe : la liste complète
           du catalogue ne sert qu'à en ajouter une, via le sélecteur. *@
        @if (!IsNew)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Règles spéciales</MudText>

                @if (_reglesDisponibles.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Aucune règle spéciale définie pour cette version. Créez-les d'abord dans
                        l'onglet « Règles spéciales » des données de jeu.
                    </MudAlert>
                }
                else
                {
                    @if (_reglesActives.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mb-3" Style="color:var(--mud-palette-text-secondary)">
                            Cette équipe n'a aucune règle spéciale.
                        </MudText>
                    }
                    else
                    {
                        @foreach (var lien in _reglesActives)
                        {
                            <MudPaper Class="pa-3 mb-2" Elevation="0"
                                      Style="border:1px solid var(--mud-palette-lines-default)">
                                <MudStack Row="true" AlignItems="AlignItems.Center"
                                          Justify="Justify.SpaceBetween" Spacing="2">
                                    <MudText Typo="Typo.body2"><b>@lien.SpecialRule.Nom</b></MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RetirerRegle(lien.SpecialRule))" />
                                </MudStack>

                                @* Les règles à comportement automatique ont un
                                   réglage : le dieu, ou le mot-clé des postes visés. *@
                                @if (lien.SpecialRule.Code == SpecialRuleCodes.FavoriDe)
                                {
                                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Class="mt-2"
                                                  Label="Dieux autorisés"
                                                  HelperText="Séparés par des virgules."
                                                  Value="@lien.OptionsChoix"
                                                  ValueChanged="@(v => DefinirOptions(lien.SpecialRule, v))"
                                                  Placeholder="Khorne,Nurgle,Tzeentch" />
                                }
                                else if (lien.SpecialRule.Code == SpecialRuleCodes.CompetenceAuCapitaine)
                                {
                                    @* Champ LIBRE : la compétence offerte est un
                                       paramètre, pas une valeur en dur. *@
                                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Class="mt-2"
                                                  Label="Compétence offerte au capitaine"
                                                  HelperText="Nom exact de la compétence, ex. « Pro ». Le coach désigne ensuite son capitaine."
                                                  Error="@string.IsNullOrWhiteSpace(lien.OptionsChoix)"
                                                  Value="@lien.OptionsChoix"
                                                  ValueChanged="@(v => DefinirOptions(lien.SpecialRule, v))"
                                                  Placeholder="Pro" />

                                    @if (string.IsNullOrWhiteSpace(lien.OptionsChoix))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">
                                            Sans compétence, cette règle n'a aucun effet.
                                        </MudText>
                                    }
                                }
                                else if (lien.SpecialRule.Code == SpecialRuleCodes.CoutNulParMotCle
                                         || lien.SpecialRule.Code == SpecialRuleCodes.RecrutementGratuitParMotCle)
                                {
                                    @* Champ LIBRE : viser un autre poste qu'un
                                       Trois-quart est un réglage, pas un dev. *@
                                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Class="mt-2"
                                                  Label="Postes concernés (mot-clé)"
                                                  HelperText="Mot-clé porté par les postes visés, ex. « Trois-quart ». Plusieurs valeurs séparées par des virgules."
                                                  Error="@string.IsNullOrWhiteSpace(lien.OptionsChoix)"
                                                  Value="@lien.OptionsChoix"
                                                  ValueChanged="@(v => DefinirOptions(lien.SpecialRule, v))"
                                                  Placeholder="Trois-quart" />

                                    @* Plafond par phase d'après-match : sans lui,
                                       un coach remplissait tout son effectif
                                       gratuitement d'un coup. *@
                                    @if (lien.SpecialRule.Code == SpecialRuleCodes.RecrutementGratuitParMotCle)
                                    {
                                        <MudNumericField T="int" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Class="mt-2" Min="0" Max="9"
                                                         Label="Recrues offertes par après-match"
                                                         HelperText="1 dans le livre de règles. 0 = sans limite."
                                                         Value="@lien.LimiteParApresMatch"
                                                         ValueChanged="@(v => DefinirLimite(lien.SpecialRule, v))" />
                                    }

                                    @if (string.IsNullOrWhiteSpace(lien.OptionsChoix))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">
                                            Sans mot-clé, cette règle n'a aucun effet.
                                        </MudText>
                                    }
                                }
                            </MudPaper>
                        }
                    }

                    @if (_reglesAjoutables.Count > 0)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
                            @* Placeholder à 0 : sans lui MudSelect affiche « 0 » brut. *@
                            <MudSelect T="int" @bind-Value="_regleAAjouter" Label="Ajouter une règle"
                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Style="flex:1 1 240px; min-width:0">
                                <MudSelectItem Value="0">— choisir —</MudSelectItem>
                                @foreach (var r in _reglesAjoutables)
                                {
                                    <MudSelectItem Value="@r.Id">@r.Nom</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Disabled="@(_regleAAjouter == 0)"
                                       OnClick="AjouterRegle">Ajouter</MudButton>
                        </MudStack>
                    }
                }
            </MudPaper>
        }

        @if (!IsNew)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.h6">Postes</MudText>
                    <MudStack Row="true" Spacing="1">
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                                   OnClick="AjouterPoste">Ajouter poste</MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Secondary"
                                   OnClick="ImporterDepuisReserve">Importer depuis la Réserve</MudButton>
                    </MudStack>
                </MudStack>
                <MudTable Items="@_team.Postes" Dense="true" Hover="true" Style="font-size:12px">
                    <HeaderContent>
                        <MudTh Style="width:30%">Poste</MudTh>
                        <MudTh Style="width:8%; text-align:center">Q.</MudTh>
                        <MudTh Style="width:10%; text-align:right">Coût</MudTh>
                        <MudTh Style="width:18%; text-align:center">M / F / AG / CP / AR</MudTh>
                        <MudTh Style="width:14%">P / S</MudTh>
                        <MudTh Style="width:14%">Skills départ</MudTh>
                        <MudTh Style="width:9%">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Poste">
                            <div style="font-weight:600">
                                @context.Nom
                            </div>
                            @if (!string.IsNullOrEmpty(context.MotsCles))
                            {
                                <div style="font-size:10px; color:#9e9e9e; font-style:italic">
                                    @context.MotsCles.Replace(",", ", ")
                                </div>
                            }
                        </MudTd>
                        <MudTd DataLabel="Quantité max" Style="text-align:center">@context.QuantiteMax</MudTd>
                        <MudTd DataLabel="Coût" Style="text-align:right">@context.Cout.ToString("N0")</MudTd>
                        <MudTd DataLabel="M / F / AG / CP / AR" Style="text-align:center; font-family:monospace; font-size:11px">
                            @context.Mouvement / @context.Force / @context.Agilite / @context.CapacitePasse / @context.Armure
                        </MudTd>
                        <MudTd DataLabel="P / S">
                            <div style="font-size:11px"><span style="color:#90caf9">P:</span> @CategoryAccessHelpers.FormatAcces(context.AccesCategories.Where(a => a.EstPrincipale).Select(a => a.SkillCategoryDef))</div>
                            <div style="font-size:11px"><span style="color:#ce93d8">S:</span> @CategoryAccessHelpers.FormatAcces(context.AccesCategories.Where(a => !a.EstPrincipale).Select(a => a.SkillCategoryDef))</div>
                        </MudTd>
                        <MudTd DataLabel="Skills départ">
                            @if (context.CompetencesDepart?.Any() == true)
                            {
                                <div style="display:flex; flex-wrap:wrap; gap:2px">
                                    @foreach (var c in context.CompetencesDepart)
                                    {
                                        <span style="font-size:10px; padding:1px 4px; background:rgba(229,57,53,0.15); border-radius:3px; white-space:nowrap">
                                            @c.Skill?.Nom
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span style="font-size:10px; color:#666">—</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           title="Éditer ce poste"
                                           OnClick="@(() => EditerPoste(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Color="Color.Secondary"
                                           title="Renvoyer une copie de ce poste dans la Réserve"
                                           OnClick="@(() => RenvoyerVersReserve(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           title="Supprimer ce poste"
                                           OnClick="@(() => SupprimerPoste(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.h6">Limites par mot-clé</MudText>
                    <MudStack Row="true" Spacing="1">
                        <MudTextField @bind-Value="_nouveauMotCle" Label="Mot-clé" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudNumericField @bind-Value="_nouveauMax" Label="Max" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100px" />
                        <MudButton OnClick="AjouterLimite" Color="Color.Primary">+ Ajouter</MudButton>
                    </MudStack>
                </MudStack>
                <MudTable Items="@_team.LimitesMotsCles" Dense="true">
                    <HeaderContent>
                        <MudTh>Mot-clé</MudTh>
                        <MudTh>Max</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Mot-clé">@context.MotCle</MudTd>
                        <MudTd DataLabel="Max">@context.Max</MudTd>
                        <MudTd DataLabel="Action"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => SupprimerLimite(context.Id))" /></MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    [Parameter] public string IdParam { get; set; } = "";
    [SupplyParameterFromQuery] public int VersionId { get; set; }

    bool IsNew => IdParam == "new";
    TeamType? _team;
    string _nouveauMotCle = "";
    int _nouveauMax = 1;

    /// <summary>Catalogue de règles spéciales de la version de l'équipe éditée.</summary>
    List<SpecialRule> _reglesDisponibles = [];

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    async Task ChargerAsync()
    {
        if (IsNew)
        {
            _team = new TeamType { Nom = "", Categorie = 0, CoutRelance = 50_000 };
        }
        else if (int.TryParse(IdParam, out var id))
        {
            _team = await DataEditService.GetTeamTypeAsync(id);
            if (_team is null) { Nav.NavigateTo("/admin/donnees"); return; }

            // Le catalogue est scopé par version : on ne propose que les règles
            // de la version de CETTE équipe, sinon on créerait un rattachement
            // inter-versions que le service refuse (à juste titre).
            _reglesDisponibles = await DataEditService.GetReglesSpecialesAsync(_team.RulesVersionId);
        }
    }

    // ── Règles spéciales ────────────────────────────────────────────────────
    // La page ne montre QUE les règles rattachées ; le catalogue complet ne sert
    // qu'à alimenter le sélecteur d'ajout, pour ne pas surcharger l'écran.

    /// <summary>Règles réellement rattachées, dans l'ordre d'affichage.</summary>
    List<TeamTypeSpecialRule> _reglesActives =>
        _team?.ReglesSpecialesListe
            .Where(l => l.SpecialRule is not null)
            .OrderBy(l => l.SpecialRule.Ordre).ThenBy(l => l.SpecialRule.Nom)
            .ToList() ?? [];

    /// <summary>Catalogue moins ce qui est déjà rattaché.</summary>
    List<SpecialRule> _reglesAjoutables =>
        _reglesDisponibles
            .Where(r => _team?.ReglesSpecialesListe.All(l => l.SpecialRuleId != r.Id) ?? true)
            .ToList();

    /// <summary>Règle sélectionnée dans le menu déroulant. 0 = aucune.</summary>
    int _regleAAjouter;

    string OptionsDe(int regleId) =>
        _team?.ReglesSpecialesListe.FirstOrDefault(l => l.SpecialRuleId == regleId)?.OptionsChoix ?? "";

    async Task AjouterRegle()
    {
        if (_team is null || _regleAAjouter == 0) return;
        try
        {
            await DataEditService.AssocierRegleSpecialeAsync(_team.Id, _regleAAjouter);
            _regleAAjouter = 0;
            await ChargerAsync();   // relit l'état réel plutôt que de le deviner
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    async Task RetirerRegle(SpecialRule regle)
    {
        if (_team is null) return;
        try
        {
            await DataEditService.DissocierRegleSpecialeAsync(_team.Id, regle.Id);
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    async Task DefinirOptions(SpecialRule regle, string options)
    {
        if (_team is null) return;
        try
        {
            await DataEditService.AssocierRegleSpecialeAsync(_team.Id, regle.Id, options);
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    /// <summary>Plafond de recrues offertes par après-match pour cette race.</summary>
    async Task DefinirLimite(SpecialRule regle, int limite)
    {
        if (_team is null) return;
        try
        {
            await DataEditService.DefinirLimiteApresMatchAsync(_team.Id, regle.Id, limite);
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    async Task SauvegarderEquipe()
    {
        if (_team is null) return;
        try
        {
            if (IsNew)
            {
                var created = await DataEditService.CreerTeamTypeAsync(VersionId, _team);
                Snackbar.Add("Équipe créée", Severity.Success);
                Nav.NavigateTo($"/admin/donnees/equipes/{created.Id}", forceLoad: true);
            }
            else
            {
                await DataEditService.ModifierTeamTypeAsync(_team.Id, _team.Nom, _team.Categorie, _team.CoutRelance, _team.ReglesSpeciales, _team.ReglesSpecialesLigue);
                Snackbar.Add("Équipe modifiée", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    async Task AjouterPoste()
    {
        if (_team is null) return;
        var parameters = new DialogParameters<EditionPosteDialog>
        {
            { x => x.TeamTypeId, _team.Id },
            { x => x.VersionId, _team.RulesVersionId },
            { x => x.Existant, null }
        };
        var dialog = await DialogService.ShowAsync<EditionPosteDialog>("Nouveau poste", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await ChargerAsync();
    }

    async Task EditerPoste(PlayerPosition p)
    {
        if (_team is null) return;
        var parameters = new DialogParameters<EditionPosteDialog>
        {
            { x => x.TeamTypeId, _team.Id },
            { x => x.VersionId, _team.RulesVersionId },
            { x => x.Existant, p }
        };
        var dialog = await DialogService.ShowAsync<EditionPosteDialog>("Éditer poste", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await ChargerAsync();
    }

    async Task SupprimerPoste(PlayerPosition p)
    {
        var ok = await DialogService.ShowMessageBox("Confirmer", $"Supprimer « {p.Nom} » ?", "Supprimer", "Annuler");
        if (ok != true) return;
        try
        {
            await DataEditService.SupprimerPosteAsync(p.Id);
            Snackbar.Add("Poste supprimé", Severity.Success);
            await ChargerAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task RenvoyerVersReserve(PlayerPosition p)
    {
        var ok = await DialogService.ShowMessageBox(
            "Renvoyer dans la Réserve",
            $"Copier « {p.Nom} » dans la Réserve de cette version de règles ? Le poste reste dans cette équipe.",
            "Copier", "Annuler");
        if (ok != true) return;
        try
        {
            await DataEditService.ExporterPosteVersReserveAsync(p.Id);
            Snackbar.Add($"« {p.Nom} » copié dans la Réserve", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    async Task ImporterDepuisReserve()
    {
        if (_team is null) return;
        var parameters = new DialogParameters<ImportReserveDialog>
        {
            { x => x.VersionId, _team.RulesVersionId }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ImportReserveDialog>("Importer depuis la Réserve", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is List<int> ids && ids.Count > 0)
        {
            try
            {
                await DataEditService.ImporterReserveVersTeamTypeAsync(_team.Id, ids);
                Snackbar.Add($"{ids.Count} poste(s) importé(s) depuis la Réserve", Severity.Success);
                await ChargerAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
            }
        }
    }

    async Task AjouterLimite()
    {
        if (_team is null || string.IsNullOrWhiteSpace(_nouveauMotCle)) return;
        await DataEditService.AjouterLimiteAsync(_team.Id, _nouveauMotCle, _nouveauMax);
        _nouveauMotCle = "";
        _nouveauMax = 1;
        await ChargerAsync();
    }

    async Task SupprimerLimite(int id)
    {
        await DataEditService.SupprimerLimiteAsync(id);
        await ChargerAsync();
    }

    void Retour() => Nav.NavigateTo("/admin/donnees");
}
