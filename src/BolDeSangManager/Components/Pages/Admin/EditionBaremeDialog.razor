@using BolDeSangManager.Data.Models
@using BolDeSangManager.Services
@inject DataEditService DataEditService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle1" Class="mb-1"><b>@Version.Nom</b></MudText>
        <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1"><b>Points d'expérience</b></MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
            Valeurs de référence de cette version : une nouvelle ligue les reprend
            à sa création et peut ensuite les ajuster pour son propre format.
        </MudText>

        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            Les ligues <b>déjà créées</b> gardent le barème qu'elles ont enregistré :
            modifier cette version ne change rien à leurs matchs.
        </MudAlert>

        <MudGrid Spacing="2">
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="_td" Label="Touchdown"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="_passe" Label="Passe complétée"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="_interception" Label="Interception"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="_elimination" Label="Élimination"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="_mvp" Label="@($"Bonus {DisplayHelpers.LabelMvp}")"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="_xpDeviation" Label="Déviation"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="_xpAgression" Label="Agression"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="99" />
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle2" Class="mb-1"><b>Points de classement</b></MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
            Valeurs de départ des nouvelles ligues. Les paliers par nombre de tours,
            eux, se règlent ligue par ligue : ils relèvent du format, pas des règles.
        </MudText>

        <MudGrid Spacing="2">
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_ptVictoire" Label="Victoire"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_ptNul" Label="Nul"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_ptDefaite" Label="Défaite"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_ptTd" Label="Bonus touchdown"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_ptElim" Label="Bonus élimination"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_ptInt" Label="Bonus interception"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_ptPasse" Label="Bonus passe"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_ptDev" Label="Bonus déviation"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_ptAgr" Label="Bonus agression"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Annuler">Annuler</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="Enregistrer" Disabled="@_enCours">
            @(_enCours ? "Enregistrement…" : "Sauvegarder")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public RulesVersion Version { get; set; } = default!;

    int _td, _passe, _interception, _elimination, _mvp, _xpDeviation, _xpAgression;
    int _ptVictoire, _ptNul, _ptDefaite, _ptTd, _ptElim, _ptInt, _ptPasse, _ptDev, _ptAgr;
    bool _enCours;

    protected override void OnInitialized()
    {
        _td           = Version.XpParTouchdown;
        _passe        = Version.XpParPasse;
        _interception = Version.XpParInterception;
        _elimination  = Version.XpParElimination;
        _mvp          = Version.XpBonusMvp;
        _xpDeviation  = Version.XpParDeviation;
        _xpAgression  = Version.XpParAgression;

        // ⚠️ Une copie de travail construite champ par champ oublie tout champ
        // neuf, qui repart alors à son défaut C# et écrase la valeur en base à
        // la simple ouverture de la modale. D'où la reprise exhaustive ici.
        var pts = BaremePoints.DeVersion(Version);
        _ptVictoire = pts.Victoire;
        _ptNul      = pts.Nul;
        _ptDefaite  = pts.Defaite;
        _ptTd       = pts.ParTouchdown;
        _ptElim     = pts.ParElimination;
        _ptInt      = pts.ParInterception;
        _ptPasse    = pts.ParPasse;
        _ptDev      = pts.ParDeviation;
        _ptAgr      = pts.ParAgression;
    }

    void Annuler() => MudDialog.Cancel();

    async Task Enregistrer()
    {
        _enCours = true;
        try
        {
            await DataEditService.ModifierBaremeXpAsync(Version.Id, new XpBareme
            {
                ParTouchdown    = _td,
                ParPasse        = _passe,
                ParInterception = _interception,
                ParElimination  = _elimination,
                BonusMvp        = _mvp,
                ParDeviation    = _xpDeviation,
                ParAgression    = _xpAgression
            });

            await DataEditService.ModifierBaremePointsAsync(Version.Id, new BaremePoints
            {
                Victoire        = _ptVictoire,
                Nul             = _ptNul,
                Defaite         = _ptDefaite,
                ParTouchdown    = _ptTd,
                ParElimination  = _ptElim,
                ParInterception = _ptInt,
                ParPasse        = _ptPasse,
                ParDeviation    = _ptDev,
                ParAgression    = _ptAgr
            });

            Snackbar.Add($"Barèmes de « {Version.Nom} » mis à jour.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally { _enCours = false; }
    }
}
