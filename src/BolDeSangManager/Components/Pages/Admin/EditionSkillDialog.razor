@using BolDeSangManager.Data.Models
@using BolDeSangManager.Data.Enums
@using BolDeSangManager.Services
@inject DataEditService DataEditService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="8"><MudTextField @bind-Value="_data.Nom" Label="Nom" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int" @bind-Value="_data.SkillCategoryDefId" Label="Catégorie" Variant="Variant.Outlined">
                    @foreach (var c in _categories)
                    {
                        <MudSelectItem T="int" Value="@c.Id">@c.Nom (@c.Code)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_data.Description" Label="Description" Lines="3" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6"><MudCheckBox @bind-Value="_data.EstElite" Label="Élite" /></MudItem>
            <MudItem xs="6"><MudCheckBox @bind-Value="_data.EstTrait" Label="Trait" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Annuler">Annuler</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Sauvegarder">Sauvegarder</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int VersionId { get; set; }
    [Parameter] public Skill? Existant { get; set; }

    Skill _data = new() { Nom = "", Description = "" };
    List<SkillCategoryDef> _categories = [];

    protected override async Task OnInitializedAsync()
    {
        _categories = await DataEditService.GetCategoriesAsync(VersionId);

        if (Existant is not null)
        {
            _data = new Skill
            {
                Id = Existant.Id, Nom = Existant.Nom,
                SkillCategoryDefId = Existant.SkillCategoryDefId,
                Description = Existant.Description, EstElite = Existant.EstElite, EstTrait = Existant.EstTrait
            };
        }
        else if (_categories.Count > 0)
        {
            _data.SkillCategoryDefId = _categories[0].Id;
        }
    }

    void Annuler() => MudDialog.Cancel();

    async Task Sauvegarder()
    {
        if (_data.SkillCategoryDefId == 0)
        {
            Snackbar.Add("Créez d'abord au moins une catégorie de compétence.", Severity.Warning);
            return;
        }
        try
        {
            if (Existant is null)
                await DataEditService.CreerSkillAsync(VersionId, _data);
            else
                await DataEditService.ModifierSkillAsync(Existant.Id, _data.Nom, _data.SkillCategoryDefId, _data.Description, _data.EstElite, _data.EstTrait);
            Snackbar.Add("Compétence sauvegardée", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }
}
