    async Task ExporterVersion(int versionId)
    {
        try
        {
            var bytes = await GameDataExportService.ExportAsync(versionId);
            var version = _versions.FirstOrDefault(v => v.Id == versionId);
            var nomFichier = $"gamedata_{version?.Nom ?? versionId.ToString()}.json"
                .Replace(" ", "_").Replace("/", "-");
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("blazorDownloadBase64File", nomFichier, "application/json", base64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur export : {ex.Message}", Severity.Error);
        }
    }

    async Task ExporterReserve()
    {
        try
        {
            var bytes = await GameDataExportService.ExportReserveAsync(_selectedVersionId);
            var version = _versions.FirstOrDefault(v => v.Id == _selectedVersionId);
            var nomFichier = $"reserve_{version?.Nom ?? _selectedVersionId.ToString()}.json".Replace(" ", "_").Replace("/", "-");
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("blazorDownloadBase64File", nomFichier, "application/json", base64);
        }
        catch (Exception ex) { Snackbar.Add($"Erreur export : {ex.Message}", Severity.Error); }
    }

    async Task ImporterReserve(InputFileChangeEventArgs e)
    {
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);

            ms.Position = 0;
            var (success, imported, errors) = await GameDataExportService.ImportReserveAsync(ms, _selectedVersionId);

            // F3 : refus lié à la révision du fichier → on demande confirmation
            // explicite, puis on rejoue le même import en forçant.
            if (!success && errors.Count == 1 && EstAvertissementRevision(errors[0]))
            {
                var ok = await DialogService.ShowMessageBox(
                    "Vérifier avant d'importer",
                    errors[0],
                    yesText: "Importer quand même", cancelText: "Annuler");

                if (ok != true) { Snackbar.Add("Import annulé.", Severity.Normal); return; }

                ms.Position = 0;
                (success, imported, errors) = await GameDataExportService.ImportReserveAsync(
                    ms, _selectedVersionId, confirmerMalgreRevision: true);
            }

            if (success)
            {
                Snackbar.Add($"{imported} poste(s) de réserve importé(s)." + (errors.Count > 0 ? $" ({errors.Count} avertissement(s))" : ""), Severity.Success);
                foreach (var err in errors) Snackbar.Add(err, Severity.Warning);
                await ChargerDonneesAsync();
            }
            else
            {
                foreach (var err in errors) Snackbar.Add(err, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Erreur import : {ex.Message}", Severity.Error); }
    }

    /// <summary>Distingue un refus de traçabilité (F3) d'une vraie erreur de lecture.</summary>
    static bool EstAvertissementRevision(string message) =>
        message.Contains("révision", StringComparison.OrdinalIgnoreCase);

    async Task ImporterVersion(InputFileChangeEventArgs e)
    {
        _importEnCours = true;
        try
        {
            var file = e.File;
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            var bytes = ms.ToArray();

            var parameters = new DialogParameters<ImportVersionDialog>
            {
                { x => x.GameId, _selectedGameId },
                { x => x.JsonBytes, bytes }
            };
            var dialog = await DialogService.ShowAsync<ImportVersionDialog>("Importer une version", parameters);
            var result = await dialog.Result;
            if (result is not null && !result.Canceled)
            {
                await ChargerVersionsAsync();
                Snackbar.Add("Version importée avec succès.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur import : {ex.Message}", Severity.Error);
        }
        finally
        {
            _importEnCours = false;
        }
    }
