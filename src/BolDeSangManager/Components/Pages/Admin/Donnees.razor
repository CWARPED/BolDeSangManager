    async Task ActiverVersion(RulesVersion v)
    {
        var actuelle = _versions.FirstOrDefault(x => x.EstActive && x.Id != v.Id);
        var message = actuelle is null
            ? $"Rendre « {v.Nom} » active ? Elle sera utilisée par défaut pour les nouvelles ligues."
            : $"Rendre « {v.Nom} » active ? « {actuelle.Nom} » ne le sera plus. "
              + "Les ligues et équipes existantes ne sont pas modifiées.";

        var ok = await DialogService.ShowMessageBox("Changer la version active", message, "Activer", "Annuler");
        if (ok != true) return;

        try
        {
            await DataEditService.ActiverVersionAsync(v.Id);
            Snackbar.Add($"« {v.Nom} » est maintenant la version active.", Severity.Success);
            await ChargerVersionsAsync();
