@page "/admin/donnees"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,GrandCommissaire")]
@using BolDeSangManager.Data
@using BolDeSangManager.Data.Models
@using BolDeSangManager.Data.Enums
@using BolDeSangManager.Services
@inject DataEditService DataEditService
@inject StaffService StaffService
@inject LeagueService LeagueService
@inject GameDataExportService GameDataExportService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Édition des données</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Édition des données</MudText>

    <MudStack Row="true" Spacing="2" Class="mb-4">
        <MudSelect T="int" Label="Jeu" Value="_selectedGameId" ValueChanged="@OnGameChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:200px">
            @foreach (var g in _games)
            {
                <MudSelectItem Value="@g.Id">@g.Nom</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int" Label="Version de règles" Value="_selectedVersionId" ValueChanged="@OnVersionChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:200px">
            @foreach (var v in _versions)
            {
                <MudSelectItem Value="@v.Id">@v.Nom @(v.EstActive ? "(active)" : "")</MudSelectItem>
            }
        </MudSelect>
    </MudStack>

    <MudTabs Elevation="1" Rounded="true" Class="tabs-compact" PanelClass="pa-4">
        <MudTabPanel Text="Réserve">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_reserve.Count poste(s) en réserve</b></MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton StartIcon="@Icons.Material.Filled.Download" Color="Color.Secondary" Variant="Variant.Outlined"
                               OnClick="ExporterReserve" Disabled="@(_reserve.Count == 0)">Exporter la Réserve</MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Upload" Color="Color.Secondary" Variant="Variant.Outlined"
                               OnClick="@(() => JS.InvokeVoidAsync("clickElement", "importReserveInput"))">Importer une Réserve</MudButton>
                    <InputFile id="importReserveInput" OnChange="ImporterReserve" accept=".json" style="display:none" />
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                               OnClick="AjouterReservePoste">Ajouter un poste de réserve</MudButton>
                </MudStack>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mb-2" Style="color:#9e9e9e">
                Postes réutilisables de cette version de règles. Importez-les dans une équipe depuis l'édition de l'équipe (bouton « Importer depuis la Réserve »). L'import crée une copie indépendante.
            </MudText>
            <MudTable Items="@_reserve" Dense="true" Hover="true" Style="font-size:12px">
                <HeaderContent>
                    <MudTh>Poste</MudTh>
                    <MudTh Style="text-align:center">Q.</MudTh>
                    <MudTh Style="text-align:right">Coût</MudTh>
                    <MudTh Style="text-align:center">M / F / AG / CP / AR</MudTh>
                    <MudTh>P / S</MudTh>
                    <MudTh>Skills départ</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Poste">
                        <div style="font-weight:600">@context.Nom</div>
                        @if (!string.IsNullOrEmpty(context.MotsCles))
                        {
                            <div style="font-size:10px; color:#9e9e9e; font-style:italic">@context.MotsCles.Replace(",", ", ")</div>
                        }
                    </MudTd>
                    <MudTd DataLabel="Quantité max" Style="text-align:center">@context.QuantiteMax</MudTd>
                    <MudTd DataLabel="Coût" Style="text-align:right">@context.Cout.ToString("N0")</MudTd>
                    <MudTd DataLabel="M / F / AG / CP / AR" Style="text-align:center; font-family:monospace; font-size:11px">
                        @context.Mouvement / @context.Force / @context.Agilite / @context.CapacitePasse / @context.Armure
                    </MudTd>
                    <MudTd DataLabel="P / S">
                        <div style="font-size:11px"><span style="color:#90caf9">P:</span> @CategoryAccessHelpers.FormatAcces(context.AccesCategories.Where(a => a.EstPrincipale).Select(a => a.SkillCategoryDef))</div>
                        <div style="font-size:11px"><span style="color:#ce93d8">S:</span> @CategoryAccessHelpers.FormatAcces(context.AccesCategories.Where(a => !a.EstPrincipale).Select(a => a.SkillCategoryDef))</div>
                    </MudTd>
                    <MudTd DataLabel="Skills départ">
                        @if (context.CompetencesDepart?.Any() == true)
                        {
                            <div style="display:flex; flex-wrap:wrap; gap:2px">
                                @foreach (var c in context.CompetencesDepart)
                                {
                                    <span style="font-size:10px; padding:1px 4px; background:rgba(229,57,53,0.15); border-radius:3px; white-space:nowrap">@c.Skill?.Nom</span>
                                }
                            </div>
                        }
                        else { <span style="font-size:10px; color:#666">—</span> }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditerReservePoste(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => SupprimerReservePoste(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Staff">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_staff.Count élément(s) de staff</b></MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="AjouterStaff">Ajouter un staff</MudButton>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mb-2" Style="color:#9e9e9e">
                Éléments achetables par les équipes : fans dévoués, relances, apothicaire…
                Ces valeurs sont celles des <b>règles</b> : chaque ligue en prend une copie
                à sa création, que le commissaire peut ensuite ajuster pour son format.
                Modifier ici n'affecte donc pas les ligues déjà créées.
            </MudText>
            <MudTable Items="@_staff" Dense="true" Hover="true" Style="font-size:12px">
                <HeaderContent>
                    <MudTh>Nom</MudTh>
                    <MudTh Style="text-align:right">Coût</MudTh>
                    <MudTh Style="text-align:center">Création (min–max)</MudTh>
                    <MudTh Style="text-align:center">Plafond ligue</MudTh>
                    <MudTh Style="text-align:center">Actif</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">
                        <div style="font-weight:600">@context.Nom</div>
                        @if (!string.IsNullOrWhiteSpace(context.Description))
                        {
                            <div style="font-size:10px; color:#9e9e9e; font-style:italic">@context.Description</div>
                        }
                    </MudTd>
                    <MudTd DataLabel="Coût" Style="text-align:right">
                        @if (context.CoutDepuisTypeEquipe)
                        {
                            <span style="font-size:11px; color:#90caf9" title="Le prix vient de la fiche de la race (Coût relance)">
                                selon la race
                            </span>
                        }
                        else
                        {
                            @context.Cout.ToString("N0")
                        }
                    </MudTd>
                    <MudTd DataLabel="Création" Style="text-align:center">
                        @context.MinCreation – @context.MaxCreation
                    </MudTd>
                    <MudTd DataLabel="Plafond ligue" Style="text-align:center">
                        @(context.MaxLigue?.ToString() ?? "—")
                    </MudTd>
                    <MudTd DataLabel="Actif" Style="text-align:center">
                        @if (context.EstActif)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.DoNotDisturbOn" Size="Size.Small" Color="Color.Default" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditerStaff(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => SupprimerStaff(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Équipes">
            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_teamTypes.Count équipe(s)</b></MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="AjouterTeamType">Ajouter une équipe</MudButton>
            </MudStack>
            <MudTable Items="@_teamTypes" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<TeamType,object>(x => x.Nom)">Nom</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TeamType,object>(x => x.Categorie)">Catégorie</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TeamType,object>(x => x.CoutRelance)">Coût relance</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<TeamType,object>(x => (object)(x.Postes?.Count ?? 0))">Nb postes</MudTableSortLabel></MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">@context.Nom</MudTd>
                    <MudTd DataLabel="Catégorie">@context.Categorie</MudTd>
                    <MudTd DataLabel="Coût relance">@context.CoutRelance.ToString("N0") po</MudTd>
                    <MudTd DataLabel="Nb postes">@(context.Postes?.Count ?? 0)</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditerTeamType(context.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => SupprimerTeamType(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Compétences">
            <MudExpansionPanels Elevation="0" Class="mb-3">
                <MudExpansionPanel Dense="true">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle2">
                                <b>Catégories</b>
                                <span style="color:var(--mud-palette-text-secondary)"> — @_categories.Count définie(s) pour cette version</span>
                            </MudText>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                                Les catégories appartiennent à la version de règles sélectionnée et sont clonées avec elle.
                                Une catégorie utilisée ne peut pas être supprimée, mais peut être renommée.
                            </MudText>
                            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                                       Size="Size.Small" OnClick="AjouterCategorie">Ajouter une catégorie</MudButton>
                        </MudStack>
                        <MudTable Items="@_categories" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Nom</MudTh>
                                <MudTh Style="width:10%">Code</MudTh>
                                <MudTh Style="width:20%">Compétences</MudTh>
                                <MudTh Style="width:12%">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Nom"><b>@context.Nom</b></MudTd>
                                <MudTd DataLabel="Code"><MudChip T="string" Size="Size.Small" Color="Color.Default">@context.Code</MudChip></MudTd>
                                <MudTd DataLabel="Compétences">@NbSkills(context.Id)</MudTd>
                                <MudTd DataLabel="Actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   title="Renommer / changer le code"
                                                   OnClick="@(() => EditerCategorie(context))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   title="Supprimer cette catégorie"
                                                   OnClick="@(() => SupprimerCategorie(context))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>

            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.subtitle1"><b>@_skillsFiltres.Count compétence(s)</b></MudText>
                    <MudSelect T="int?" Label="Catégorie" Value="_categorieFiltre" ValueChanged="@OnCategorieChanged"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:150px" Clearable="true">
                        @foreach (var c in _categories)
                        {
                            <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Nom</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="AjouterSkill">Ajouter une compétence</MudButton>
            </MudStack>
            <MudTable Items="@_skillsFiltres" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<Skill,object>(x => x.Nom)">Nom</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<Skill,object>(x => x.SkillCategoryDef.Nom)">Catégorie</MudTableSortLabel></MudTh>
                    <MudTh>Trait/Élite</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">@context.Nom</MudTd>
                    <MudTd DataLabel="Catégorie">@(context.SkillCategoryDef?.Nom ?? "—")</MudTd>
                    <MudTd DataLabel="Trait/Élite">
                        @if (context.EstElite) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">Élite</MudChip> }
                        @if (context.EstTrait) { <MudChip T="string" Size="Size.Small" Color="Color.Info">Trait</MudChip> }
                    </MudTd>
                    <MudTd DataLabel="Description" Style="max-width:400px; white-space:normal">@context.Description</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditerSkill(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => SupprimerSkill(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Versions">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1"><b>@_versions.Count version(s)</b></MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton StartIcon="@Icons.Material.Filled.Upload" Color="Color.Secondary" Variant="Variant.Outlined"
                               OnClick="@(() => JS.InvokeVoidAsync("clickElement", "importGameDataInput"))"
                               Disabled="@_importEnCours">
                        @(_importEnCours ? "Import en cours…" : "Importer une version")
                    </MudButton>
                    <InputFile id="importGameDataInput" OnChange="ImporterVersion"
                               accept=".json" style="display:none" />
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                               OnClick="CreerVersion">Créer une nouvelle version</MudButton>
                </MudStack>
            </MudStack>
            <MudTable Items="@_versions" Dense="true">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<RulesVersion,object>(x => x.Nom)">Nom</MudTableSortLabel></MudTh>
                    <MudTh>Active</MudTh>
                    <MudTh>Barème d'XP</MudTh>
                    <MudTh>Révision</MudTh>
                    <MudTh Style="width:16%; white-space:nowrap">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nom">@context.Nom</MudTd>
                    <MudTd DataLabel="Active">
                        @if (context.EstActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Oui</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Non</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Barème d'XP">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            TD @context.XpParTouchdown · Passe @context.XpParPasse ·
                            Int @context.XpParInterception · Élim @context.XpParElimination ·
                            MVP @context.XpBonusMvp
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Révision">
                        @if (context.Revision > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     title="@($"Dernier export : {context.DernierExportLe?.ToLocalTime():dd/MM/yyyy à HH'h'mm}")">
                                rév. @context.Revision
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">jamais exportée</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                       Color="@(context.EstActive ? Color.Success : Color.Default)"
                                       Disabled="@context.EstActive"
                                       title="@(context.EstActive
                                           ? "Version déjà active — utilisée par défaut pour les nouvelles ligues"
                                           : "Définir comme version active (utilisée par défaut pour les nouvelles ligues)")"
                                       OnClick="@(() => ActiverVersion(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       title="Renommer cette version"
                                       OnClick="@(() => RenommerVersion(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.MilitaryTech" Size="Size.Small"
                                       title="Modifier le barème d'XP de cette version"
                                       OnClick="@(() => EditerBareme(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                       title="Exporter cette version"
                                       OnClick="@(() => ExporterVersion(context.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       title="Supprimer cette version"
                                       OnClick="@(() => SupprimerVersion(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    List<Game> _games = [];
    List<RulesVersion> _versions = [];
    List<StaffDefinition> _staff = [];
    List<TeamType> _teamTypes = [];
    List<PoolPosition> _reserve = [];
    List<Skill> _skills = [];
    List<SkillCategoryDef> _categories = [];
    int _selectedGameId;
    int _selectedVersionId;
    int? _categorieFiltre;
    bool _importEnCours;

    List<Skill> _skillsFiltres =>
        _categorieFiltre is null ? _skills : _skills.Where(s => s.SkillCategoryDefId == _categorieFiltre).ToList();

    int NbSkills(int categorieId) => _skills.Count(s => s.SkillCategoryDefId == categorieId);

    protected override async Task OnInitializedAsync()
    {
        _games = await LeagueService.GetGamesAsync();
        if (_games.Any())
        {
            _selectedGameId = _games[0].Id;
            await ChargerVersionsAsync();
        }
    }

    async Task ChargerVersionsAsync()
    {
        _versions = await DataEditService.GetVersionsAsync(_selectedGameId);
        _selectedVersionId = _versions.FirstOrDefault(v => v.EstActive)?.Id ?? _versions.FirstOrDefault()?.Id ?? 0;
        await ChargerDonneesAsync();
    }

    async Task ChargerDonneesAsync()
    {
        if (_selectedVersionId == 0) { _teamTypes = []; _skills = []; _reserve = []; _categories = []; _staff = []; return; }
        _teamTypes = await DataEditService.GetTeamTypesAsync(_selectedVersionId);
        _categories = await DataEditService.GetCategoriesAsync(_selectedVersionId);
        _skills = await DataEditService.GetSkillsAsync(_selectedVersionId);
        _reserve = await DataEditService.GetReserveAsync(_selectedVersionId);
        _staff = await StaffService.GetStaffTypesAsync(_selectedVersionId);
        // Le filtre pointe sur une catégorie d'une autre version : le réinitialiser
        if (_categorieFiltre is int f && !_categories.Any(c => c.Id == f)) _categorieFiltre = null;
    }

    // ─── Staff ────────────────────────────────────────────────────────────────

    async Task AjouterStaff()
    {
        if (_selectedVersionId == 0) return;

        var modele = new StaffDefinition
        {
            RulesVersionId = _selectedVersionId,
            Ordre = (_staff.LastOrDefault()?.Ordre ?? 0) + 1,
            MaxCreation = 1
        };
        await OuvrirDialogueStaffAsync("Ajouter un staff", modele, async m =>
        {
            await StaffService.AjouterStaffTypeAsync(m);
            Snackbar.Add($"« {m.Nom} » ajouté.", Severity.Success);
        });
    }

    async Task EditerStaff(StaffDefinition staff)
    {
        // Copie de travail : le dialogue ne doit pas modifier l'entité suivie
        // tant que l'utilisateur n'a pas validé.
        var copie = new StaffDefinition
        {
            Id = staff.Id, RulesVersionId = staff.RulesVersionId,
            Nom = staff.Nom, Description = staff.Description, Ordre = staff.Ordre,
            EstActif = staff.EstActif, Cout = staff.Cout,
            CoutDepuisTypeEquipe = staff.CoutDepuisTypeEquipe,
            MinCreation = staff.MinCreation, MaxCreation = staff.MaxCreation,
            MaxLigue = staff.MaxLigue
        };

        await OuvrirDialogueStaffAsync($"Modifier « {staff.Nom} »", copie, async m =>
        {
            await StaffService.ModifierStaffTypeAsync(m);
            Snackbar.Add($"« {m.Nom} » modifié.", Severity.Success);
        });
    }

    async Task OuvrirDialogueStaffAsync(string titre, StaffDefinition modele, Func<StaffDefinition, Task> action)
    {
        var parametres = new DialogParameters<EditionStaffDialog> { { x => x.Modele, modele } };
        var dialog = await DialogService.ShowAsync<EditionStaffDialog>(titre, parametres);
        var res = await dialog.Result;
        if (res is null || res.Canceled || res.Data is not StaffDefinition valide) return;

        try
        {
            await action(valide);
            await ChargerDonneesAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Impossible d'enregistrer ce staff.", Severity.Error);
        }
    }

    async Task SupprimerStaff(StaffDefinition staff)
    {
        var ok = await DialogService.ShowMessageBox(
            "Supprimer ce staff",
            $"Supprimer « {staff.Nom} » de cette version de règles ? "
            + "Les ligues déjà créées conservent leur copie : elles ne sont pas affectées.",
            "Supprimer", "Annuler");
        if (ok != true) return;

        try
        {
            await StaffService.SupprimerStaffTypeAsync(staff.Id);
