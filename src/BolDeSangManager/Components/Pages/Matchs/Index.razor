@page "/matchs"
@rendermode InteractiveServer
@attribute [Authorize]
@inject MatchService MatchService
@inject LeagueService LeagueService
@inject TeamService TeamService
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject CalendrierService CalendrierService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Mes matchs — BolDeSang Manager</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5" Color="Color.Error"><b>Mes matchs</b></MudText>
    @if (_matchs?.Any(m => m.DateProgrammee.HasValue) == true)
    {
        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.CalendarMonth"
                   OnClick="TelechargerTousIcs">
            Ajouter mes matchs à mon agenda
        </MudButton>
    }
</MudStack>

@if (_matchs is null)
{
    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
}
else if (!_matchs.Any())
{
    <MudAlert Severity="Severity.Info">
        Aucun match trouvé. Rejoignez une ligue et attendez le lancement de la saison.
    </MudAlert>
}
else
{
    @foreach (var groupe in _matchs.GroupBy(m => m.Division?.League?.Nom ?? "Ligue inconnue").OrderBy(g => g.Key))
    {
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2"><b>@groupe.Key</b></MudText>

        @foreach (var match in groupe.OrderBy(m => m.Ronde))
        {
            <MudCard Elevation="1" Class="mb-2" Style="@MatchBorderStyle(match.Statut)">
                <MudCardContent Class="py-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @DisplayHelpers.RondeLabel(match.Ronde)
                            </MudText>
                            <MudText Typo="Typo.body1">
                                <b>@match.EquipeDomicile?.Nom</b>
                                @if (match.ScoreDomicile.HasValue)
                                {
                                    <span style="color:#c62828"> &nbsp;@match.ScoreDomicile – @match.ScoreExterieur&nbsp; </span>
                                }
                                else
                                {
                                    <span style="color:#9e9e9e"> &nbsp;vs&nbsp; </span>
                                }
                                <b>@match.EquipeExterieur?.Nom</b>
                            </MudText>
                            @if (match.DateProgrammee.HasValue)
                            {
                                <MudText Typo="Typo.caption" Class="d-flex align-center gap-1 mt-1">
                                    <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                                    @DateLocale(match.DateProgrammee.Value)
                                    @if (!string.IsNullOrWhiteSpace(match.Lieu))
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="ms-2" />
                                        @match.Lieu
                                    }
                                </MudText>
                            }
                            else if (match.Statut is MatchStatus.Programme or MatchStatus.AJouer)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">
                                    Date à convenir
                                </MudText>
                            }
                        </div>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudChip T="string" Color="@MatchColor(match.Statut)" Size="Size.Small">
                                @MatchLabel(match.Statut)
                            </MudChip>
                            @if (match.Statut != MatchStatus.Termine && match.Statut != MatchStatus.Concede
                                 && match.Statut != MatchStatus.ValidationCompetences
                                 && match.Statut != MatchStatus.FeuilleEnSaisie)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           StartIcon="@Icons.Material.Filled.EditCalendar"
                                           OnClick="@(() => Programmer(match))">
                                    @(match.DateProgrammee.HasValue ? "Modifier la date" : "Fixer la date")
                                </MudButton>
                                @if (match.DateProgrammee.HasValue)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small"
                                                   title="Ajouter à mon agenda (.ics)"
                                                   OnClick="@(() => TelechargerIcs(match))" />
                                }
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                          Href="@($"/matchs/{match.Id}/feuille")">
                                    Saisir la feuille
                                </MudButton>
                            }
                            @if (match.Statut == MatchStatus.FeuilleEnSaisie)
                            {
                                var doitConfirmer = match.Feuille?.SaisiParId != _userId;
                                <MudButton Size="Size.Small"
                                          Variant="@(doitConfirmer ? Variant.Outlined : Variant.Text)"
                                          Color="@(doitConfirmer ? Color.Warning : Color.Default)"
                                          Href="@($"/matchs/{match.Id}/feuille")">
                                    @(doitConfirmer ? "Confirmer" : "En attente adversaire")
                                </MudButton>
                            }
                            @if (match.Statut == MatchStatus.ValidationCompetences)
                            {
                                var estDom = _mesEquipeIds.Contains(match.EquipeDomicileId);
                                var dejaValide = estDom
                                    ? (match.Feuille?.ApresMatchDomicileValide ?? false)
                                    : (match.Feuille?.ApresMatchExterieurValide ?? false);
                                <MudButton Size="Size.Small"
                                          Variant="@(dejaValide ? Variant.Text : Variant.Outlined)"
                                          Color="@(dejaValide ? Color.Success : Color.Warning)"
                                          Href="@($"/matchs/{match.Id}/apres-match")">
                                    @(dejaValide ? "Après-match ✓" : "Après-match")
                                </MudButton>
                            }
                            @if (match.Statut == MatchStatus.Termine || match.Statut == MatchStatus.FeuilleEnSaisie || match.Statut == MatchStatus.ValidationCompetences)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                          Href="@($"/matchs/{match.Id}/detail")">
                                    Détails
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }
    }
}

@code {
    // ── Calendrier (#1) ───────────────────────────────────────────────────────

    /// <summary>Date UTC stockée → affichage en heure locale du lecteur.</summary>
    static string DateLocale(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime()
            .ToString("ddd d MMM yyyy 'à' HH'h'mm");

    async Task Programmer(Match match)
    {
        var parametres = new DialogParameters<ProgrammationDialog>
        {
            { x => x.Match, match },
            { x => x.UserId, _userId },
            { x => x.EstCommissaire, false },
        };
        var dialog = await DialogService.ShowAsync<ProgrammationDialog>(
            "Date et lieu du match", parametres,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

        if (await dialog.Result is { Canceled: false }) StateHasChanged();
    }

    async Task TelechargerIcs(Match match)
    {
        var bytes = CalendrierService.GenererIcs(match);
        await JS.InvokeVoidAsync("blazorDownloadBase64File",
            $"match-{match.Id}.ics", "text/calendar", Convert.ToBase64String(bytes));
    }

    async Task TelechargerTousIcs()
    {
        if (_matchs is null) return;
        var bytes = CalendrierService.GenererIcs(_matchs, "Mes matchs — BolDeSang");
        await JS.InvokeVoidAsync("blazorDownloadBase64File",
            "mes-matchs.ics", "text/calendar", Convert.ToBase64String(bytes));
    }

    List<Match>? _matchs;
    HashSet<int> _mesEquipeIds = [];
    string _userId = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";
        var userId = _userId;

        var equipes = await TeamService.GetEquipesCoachAsync(userId);
        _mesEquipeIds = equipes.Select(e => e.Id).ToHashSet();

        // Une seule requête pour toutes les équipes du coach (voir Home.razor) :
        // la boucle précédente coûtait un aller-retour SQL par équipe.
        var tous = await MatchService.GetMatchsEquipesAsync(_mesEquipeIds);

        // Mode brouillard : même impératif que sur l'accueil. Cet écran agrège les
        // matchs de toutes les ligues du coach, il doit donc appliquer le réglage
        // de CHAQUE ligue — sinon le calendrier masqué ailleurs ressort ici.
        var ligues = await LeagueService.GetAllLiguesAsync();
        var brouillardParLigue = ligues.ToDictionary(l => l.Id, l => l.ModeBrouillard);
        var commissaireDe = ligues
            .Where(l => l.CommissaireId == userId
                        || l.CommissairesDeLigue.Any(c => c.UserId == userId))
            .Select(l => l.Id)
            .ToHashSet();

        var visibles = BrouillardHelpers.FiltrerVisiblesMultiLigues(
            tous.DistinctBy(m => m.Id), _mesEquipeIds, brouillardParLigue, commissaireDe);

        _matchs = visibles.OrderBy(m => m.Ronde).ToList();
    }
}
