@using BolDeSangManager.Data.Models
@using BolDeSangManager.Services
@inject MatchService MatchService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle1" Class="mb-1">
            <b>@Match.EquipeDomicile?.Nom</b> vs <b>@Match.EquipeExterieur?.Nom</b>
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
            @DisplayHelpers.RondeLabel(Match.Ronde)
        </MudText>

        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
            Les deux coaches et les commissaires peuvent modifier ces informations.
            Mettez-vous d'accord entre vous avant de les saisir.
        </MudAlert>

        @* PickerVariant.Dialog : en inline, le calendrier est rogné par le
           conteneur sur les écrans étroits (même correctif que CalendrierLibre).
           PickerMonth démarre le calendrier sur le mois de la ronde précédente
           plutôt que sur le mois courant : plus besoin de remonter les mois à la
           main sur téléphone. *@
        <MudDatePicker @bind-Date="_date" Label="Date du match"
                       Variant="Variant.Outlined" Class="mb-3"
                       PickerVariant="PickerVariant.Dialog"
                       @bind-PickerMonth="_moisAffiche"
                       IsDateDisabledFunc="@EstDateInterdite"
                       Clearable="true" Editable="true"
                       DateFormat="dd/MM/yyyy" />

        @if (_plancher is DateTime p)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                Ronde précédente jouée le @p.ToLocalTime().ToString("dd/MM/yyyy") :
                les dates antérieures sont désactivées.
            </MudText>
        }


        <MudTimePicker @bind-Time="_heure" Label="Heure"
                       Variant="Variant.Outlined" Class="mb-3"
                       Editable="true" AmPm="false" />

        <MudTextField @bind-Value="_lieu" Label="Lieu"
                      Variant="Variant.Outlined" Class="mb-1"
                      Placeholder="Ex : Le Repaire du Troll, salle du fond"
                      MaxLength="200" Immediate="true" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Texte libre — adresse, nom du bar, « chez Marc »…
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Annuler</MudButton>
        @if (Match.DateProgrammee.HasValue)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text"
                       OnClick="Effacer" Disabled="@_enCours">
                Effacer la date
            </MudButton>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="Enregistrer" Disabled="@_enCours">
            @(_enCours ? "Enregistrement…" : "Enregistrer")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Match Match { get; set; } = default!;
    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public bool EstCommissaire { get; set; }

    DateTime? _date;
    TimeSpan? _heure;
    string _lieu = "";
    bool _enCours;

    /// <summary>
    /// Date du dernier match programmé dans une ronde antérieure. Sert de
    /// plancher : on ne peut pas poser la ronde 5 avant la ronde 4.
    /// </summary>
    DateTime? _plancher;

    /// <summary>Mois sur lequel s'ouvre le calendrier (évite de remonter à la main).</summary>
    DateTime? _moisAffiche;

    /// <summary>
    /// Grise les jours antérieurs au plancher. C'est un garde-fou d'ergonomie :
    /// la règle est aussi appliquée côté serveur avant enregistrement.
    /// </summary>
    bool EstDateInterdite(DateTime jour) =>
        _plancher is DateTime p && jour.Date < p.ToLocalTime().Date;

    protected override async Task OnInitializedAsync()
    {
        // stocké en UTC, présenté en heure locale
        if (Match.DateProgrammee is DateTime utc)
        {
            var locale = DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();
            _date = locale.Date;
            _heure = locale.TimeOfDay;
        }
        else
        {
            _heure = new TimeSpan(20, 0, 0);   // 20 h : créneau le plus courant
        }
        _lieu = Match.Lieu ?? "";

        _plancher = await MatchService.GetDatePlancherAsync(Match.Id);

        // Le calendrier s'ouvre sur la date déjà choisie, sinon sur le mois de la
        // ronde précédente, sinon seulement sur le mois courant.
        _moisAffiche = (_date ?? _plancher?.ToLocalTime() ?? DateTime.Today);
        _moisAffiche = new DateTime(_moisAffiche.Value.Year, _moisAffiche.Value.Month, 1);
    }

    async Task Enregistrer()
    {
        if (_date is null)
        {
            Snackbar.Add("Choisissez une date, ou utilisez « Effacer la date ».", Severity.Warning);
            return;
        }

        if (_plancher is DateTime p && _date.Value.Date < p.ToLocalTime().Date)
        {
            Snackbar.Add(
                $"La ronde précédente se joue le {p.ToLocalTime():dd/MM/yyyy} : "
                + "choisissez une date au moins égale.", Severity.Warning);
            return;
        }

        // heure locale saisie → UTC stocké
        var locale = _date.Value.Date + (_heure ?? TimeSpan.Zero);
        var utc = DateTime.SpecifyKind(locale, DateTimeKind.Local).ToUniversalTime();

        await Sauver(utc);
    }

    Task Effacer() => Sauver(null);

    async Task Sauver(DateTime? utc)
    {
        _enCours = true;
        try
        {
            await MatchService.ProgrammerMatchAsync(Match.Id, utc, _lieu, UserId, EstCommissaire);
            Match.DateProgrammee = utc;
            Match.Lieu = _lieu.Trim();
            Snackbar.Add(utc.HasValue
                ? $"Match programmé le {utc.Value.ToLocalTime():dddd d MMMM yyyy à HH'h'mm}."
                : "Date effacée.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally { _enCours = false; }
    }
}
