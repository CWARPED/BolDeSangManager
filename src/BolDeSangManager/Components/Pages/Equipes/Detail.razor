@page "/equipes/{Id:int}"
@rendermode InteractiveServer
@using BolDeSangManager.Helpers
@inject TeamService TeamService
@inject MatchService MatchService
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject HaineService HaineService
@inject JoueurEditionService JoueurEdition
@inject SaisieLibreService SaisieLibre
@inject StaffService StaffService
@inject BolDeSangManager.Services.IAuthorizationService Auth

<PageTitle>@(_equipe?.Nom ?? "Équipe") — BolDeSang Manager</PageTitle>

@if (_equipe is null)
{
    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
}
else if (_masqueeParBrouillard)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-8" Elevation="2" Style="text-align:center">
            <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Large" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Class="mt-2">Fiche masquée — mode brouillard</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-4">
                <b>@_equipe.Nom</b> est votre prochain adversaire : son effectif reste caché
                jusqu'à ce que la rencontre soit jouée. C'est le principe du mode brouillard —
                on ne prépare pas un match en étudiant l'équipe d'en face.
            </MudText>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Nav.NavigateTo($"/ligues/{_equipe.LeagueId}"))">
                Retour à la ligue
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
        <div>
            <MudText Typo="Typo.h5" Color="Color.Error"><b>@_equipe.Nom</b></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @_equipe.TeamType?.Nom — @_equipe.TeamType?.Game?.Nom
                | Coach : @DisplayHelpers.NomCoach(_equipe.Coach)
                | Ligue : @_equipe.League?.Nom
            </MudText>
        </div>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @if (_peutEditer)
            {
                <MudButton Href="@($"/equipes/rejoindre?teamId={_equipe.Id}")" Variant="Variant.Outlined" Color="Color.Primary"
                          StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small">
                    Modifier
                </MudButton>
                <MudButton OnClick="ConfirmerSuppression" Variant="Variant.Outlined" Color="Color.Error"
                          StartIcon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small">
                    Supprimer
                </MudButton>
            }
            <MudButton Href="@($"/equipes/ma-feuille?teamId={_equipe.Id}")" Variant="Variant.Outlined" Color="Color.Error"
                      StartIcon="@Icons.Material.Filled.TableChart" Size="Size.Small">
                Feuille PDF
            </MudButton>
        </MudStack>
    </MudStack>

    @* ── Règles spéciales de l'équipe ─────────────────────────────────────
       Toutes les règles de la race, repliées : on touche une règle pour lire
       son effet. « Favori de… » porte en plus la divinité, que seul le
       COMMISSAIRE peut choisir (le livre rend le choix définitif). *@
    @if (_reglesSpeciales.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="mb-1">Règles spéciales</MudText>
        <MudExpansionPanels Class="mb-4" Elevation="0" Dense="true"
                            Style="border:1px solid var(--mud-palette-lines-default); border-radius:4px">
            @foreach (var lien in _reglesSpeciales)
            {
                var estFavoriDe = lien.SpecialRule.Code == SpecialRuleCodes.FavoriDe;
                <MudExpansionPanel Dense="true">
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.body2"><b>@lien.SpecialRule.Nom</b></MudText>
                            @if (estFavoriDe && !string.IsNullOrEmpty(_equipe.DiviniteChoisie))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                    @_equipe.DiviniteChoisie
                                </MudChip>
                            }
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                            @lien.SpecialRule.Description
                        </MudText>

                        @* Choix de la divinité : réservé au commissaire. *@
                        @if (estFavoriDe && _optionsDivinite.Count > 0)
                        {
                            @if (_estCommissaire && _optionsDivinite.Count > 1)
                            {
                                <MudSelect T="string" Value="@(_equipe.DiviniteChoisie)"
                                           ValueChanged="DefinirDivinite"
                                           Label="Dieu du Chaos" Variant="Variant.Outlined"
                                           Margin="Margin.Dense" Class="mt-3">
                                    <MudSelectItem Value="@("")">— non choisi —</MudSelectItem>
                                    @foreach (var d in _optionsDivinite)
                                    {
                                        <MudSelectItem Value="@d">@d</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else if (_optionsDivinite.Count == 1 && !string.IsNullOrEmpty(_equipe.DiviniteChoisie))
                            {
                                <MudText Typo="Typo.caption" Class="mt-2 d-block" Color="Color.Secondary">
                                    Imposé par la race.
                                </MudText>
                            }
                            else if (string.IsNullOrEmpty(_equipe.DiviniteChoisie))
                            {
                                <MudText Typo="Typo.caption" Class="mt-2 d-block" Color="Color.Secondary">
                                    Divinité pas encore choisie — le commissaire de la ligue peut la définir.
                                </MudText>
                            }
                        }

                        @* Capitaine : désigné par le coach ou le commissaire de la
                           ligue, dans l'édition de la ligne du joueur (crayon). *@
                        @if (lien.SpecialRule.Code == SpecialRuleCodes.CompetenceAuCapitaine)
                        {
                            var cap = _equipe.Joueurs.FirstOrDefault(p => p.EstCapitaine);
                            <MudText Typo="Typo.caption" Class="mt-2 d-block" Color="Color.Secondary">
                                @(cap is null ? "Aucun capitaine désigné." : $"Capitaine : {cap.Nom}.")
                                @HelperCapitaine()
                                @if (_peutEditerJoueurs)
                                {
                                    <text> Se désigne avec le crayon sur la ligne du joueur.</text>
                                }
                            </MudText>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }

    <!-- Statistiques d'équipe -->
    <MudGrid Class="mb-4">
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="1" Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Trésorerie</MudText>
                <MudText Typo="Typo.h6" Color="@(_equipe.Tresorerie < 0 ? Color.Error : Color.Success)">
                    <b>@_equipe.Tresorerie.ToString("N0") po</b>
                    @if (_peutEditerLibre && !_editionRessources)
                    {
                        @* #29 — Saisie libre : ouvre l'édition dans l'onglet Staff. *@
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       title="Modifier la trésorerie et le staff" aria-label="Modifier la trésorerie"
                                       OnClick="@(() => DemarrerRessources(versOnglet: true))" />
                    }
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="1" Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">VEA</MudText>
                <MudText Typo="Typo.h6"><b>@_vea.ToString("N0") po</b></MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="1" Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Bilan</MudText>
                <MudText Typo="Typo.h6"><b>@_equipe.NombreVictoires V / @_equipe.NombreNuls N / @_equipe.NombreDefaites D</b></MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="1" Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Points ligue</MudText>
                <MudText Typo="Typo.h6" Color="Color.Error"><b>@_equipe.PointsLigue</b></MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* @key : l'onglet Historique apparaît après le premier rendu (droits lus en
       asynchrone) ; sans recréation, le soulignement de l'onglet actif reste
       calé sur l'ancienne liste d'onglets. *@
    <MudTabs @key="_historiqueVisible" Elevation="1" Rounded="true" Class="tabs-compact" PanelClass="pt-4" @bind-ActivePanelIndex="_ongletActif">
        <!-- Effectif -->
        <MudTabPanel Text="@($"Effectif ({_equipe.Joueurs.Count(j => !j.EstMort && !j.EstRetraite)})")" Icon="@Icons.Material.Filled.Group">
            <div style="overflow-x:auto">
                <MudTable Items="@_equipe.Joueurs.Where(j => !j.EstMort && !j.EstRetraite).OrderBy(j => j.Numero)" Dense="true" Hover="true" Elevation="0"
                          RowClassFunc="@((TeamPlayer j, int _) => j.Id == _editionJoueurId ? "ligne-en-edition" : "")">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Nom</MudTh>
                        <MudTh>Poste</MudTh>
                        <MudTh Style="text-align:center">M</MudTh>
                        <MudTh Style="text-align:center">F</MudTh>
                        <MudTh Style="text-align:center">AG</MudTh>
                        <MudTh Style="text-align:center">CP</MudTh>
                        <MudTh Style="text-align:center">AV</MudTh>
                        <MudTh>Compétences</MudTh>
                        <MudTh Style="text-align:center">PSP</MudTh>
                        <MudTh Style="text-align:center">Amél.</MudTh>
                        <MudTh Style="text-align:center">Valeur</MudTh>
                        <MudTh>Statut</MudTh>
                        @if (_peutEditerJoueurs)
                        {
                            <MudTh></MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate Context="j">
                        <MudTd DataLabel="N°">@j.Numero</MudTd>
                        <MudTd DataLabel="Nom">
                            <b>@j.Nom</b>
                            @if (j.EstCapitaine)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">Capitaine</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Poste">
                            <div>@j.PlayerPosition?.Nom</div>
                            @if (!string.IsNullOrEmpty(j.PlayerPosition?.MotsCles))
                            {
                                <div style="font-size:10px; color:#9e9e9e; font-style:italic">
                                    @j.PlayerPosition.MotsCles.Replace(",", ", ")
                                </div>
                            }
                        </MudTd>
                        <MudTd DataLabel="Mouvement" Style="@InjuryCellStyle(j.ModMouvement)">@StatInt(j.PlayerPosition?.Mouvement ?? 0, j.ModMouvement)</MudTd>
                        <MudTd DataLabel="Force" Style="@InjuryCellStyle(j.ModForce)">@StatInt(j.PlayerPosition?.Force ?? 0, j.ModForce)</MudTd>
                        <MudTd DataLabel="Agilité" Style="@InjuryCellStyle(j.ModAgilite)">@StatStr(j.PlayerPosition?.Agilite ?? "-", j.ModAgilite, false)</MudTd>
                        <MudTd DataLabel="Passe" Style="@InjuryCellStyle(j.ModCapacitePasse)">@StatStr(j.PlayerPosition?.CapacitePasse ?? "-", j.ModCapacitePasse, false)</MudTd>
                        <MudTd DataLabel="Armure" Style="@InjuryCellStyle(j.ModArmure)">@StatStr(j.PlayerPosition?.Armure ?? "-", j.ModArmure, true)</MudTd>
                        <MudTd DataLabel="Compétences">
                            @* Un seul bloc : en vue téléphone, MudTd aligne ses enfants
                               en ligne, ce qui écrasait compétences, menu et accès. *@
                            <div>
                            <MudText Typo="Typo.caption">@CompetencesJoueur(j)</MudText>
                            @if (j.PlayerPosition?.AccesCategories.Any() == true)
                            {
                                <div style="font-size:10px; margin-top:2px">
                                    <span style="color:#90caf9">P:</span> @CategoryAccessHelpers.FormatAcces(j.PlayerPosition.AccesCategories.Where(a => a.EstPrincipale).Select(a => a.SkillCategoryDef))
                                    @if (j.PlayerPosition.AccesCategories.Any(a => !a.EstPrincipale))
                                    {
                                        <span style="color:#ce93d8; margin-left:8px">S:</span> @CategoryAccessHelpers.FormatAcces(j.PlayerPosition.AccesCategories.Where(a => !a.EstPrincipale).Select(a => a.SkillCategoryDef))
                                    }
                                </div>
                            }
                            </div>
                        </MudTd>
                        <MudTd DataLabel="PSP" Style="text-align:center">@j.PointsStarPlayer</MudTd>
                        <MudTd DataLabel="Améliorations" Style="text-align:center">@j.Improvements.Count</MudTd>
                        <MudTd DataLabel="Valeur" Style="text-align:center">@ValeurJoueurCalculator.Calculer(j, ValeurJoueurCalculator.BaremeDe(_equipe)).ToString("N0")</MudTd>
                        <MudTd DataLabel="Statut">
                            @if (j.ManqueSuivantMatch)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">Rate prochain</MudChip>
                            }
                            @if (BlessureHelpers.ASequelle(j))
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">
                                    Séquelles @SeqquellesSummary(j)
                                </MudChip>
                            }
                            @if (BlessureHelpers.NombreBP(j) is > 0 and var nbBp)
                            {
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small"
                                         title="Blessure persistante : +1 au jet d'élimination par BP">
                                    @BlessureHelpers.MarqueBP(nbBp)
                                </MudChip>
                            }
                        </MudTd>
                        @if (_peutEditerJoueurs)
                        {
                            <MudTd Style="text-align:right">@CrayonJoueur(j)</MudTd>
                        }
                    </RowTemplate>
                    <ChildRowContent Context="jl">
                        @if (_editionJoueurId == jl.Id)
                        {
                            <MudTr><td colspan="20" class="cellule-edition">@PanneauEdition(jl)</td></MudTr>
                        }
                    </ChildRowContent>
                </MudTable>
            </div>

            @{
                var absents = _equipe.Joueurs.Where(j => j.EstMort || j.EstRetraite).OrderBy(j => j.Numero).ToList();
            }
            @if (absents.Any())
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-4 mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" Class="mr-1" />
                    Morts &amp; Retraités (@absents.Count)
                </MudText>
                <div style="overflow-x:auto">
                    @* Atténuation par LIGNE, pas sur la table : le panneau d'édition
                       ouvert sous une ligne doit rester pleinement lisible. *@
                    <MudTable Items="@absents" Dense="true" Elevation="0"
                              RowClassFunc="@((TeamPlayer j, int _) => j.Id == _editionJoueurId ? "ligne-absent ligne-en-edition" : "ligne-absent")">
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Nom</MudTh>
                            <MudTh>Poste</MudTh>
                            <MudTh>Statut</MudTh>
                            <MudTh>Compétences</MudTh>
                            <MudTh Style="text-align:center">Amél.</MudTh>
                            @if (_peutEditerJoueurs)
                            {
                                <MudTh></MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate Context="j">
                            <MudTd DataLabel="N°">@j.Numero</MudTd>
                            <MudTd DataLabel="Nom">
                                <span style="text-decoration:line-through">@j.Nom</span>
                                @if (j.EstMort)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Dangerous" Color="Color.Error"
                                             Size="Size.Small" Class="ml-1" title="Mort" />
                                }
                            </MudTd>
                            <MudTd DataLabel="Poste">@j.PlayerPosition?.Nom</MudTd>
                            <MudTd DataLabel="Statut">
                                @if (j.EstMort)
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Mort</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Retraité</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Compétences">
                                <MudText Typo="Typo.caption">@CompetencesJoueur(j)</MudText>
                            </MudTd>
                            <MudTd DataLabel="Améliorations" Style="text-align:center">@j.Improvements.Count</MudTd>
                            @if (_peutEditerJoueurs)
                            {
                                <MudTd Style="text-align:right">@CrayonJoueur(j)</MudTd>
                            }
                        </RowTemplate>
                        <ChildRowContent Context="jl">
                            @if (_editionJoueurId == jl.Id)
                            {
                                <MudTr><td colspan="20" class="cellule-edition">@PanneauEdition(jl)</td></MudTr>
                            }
                        </ChildRowContent>
                    </MudTable>
                </div>
            }
        </MudTabPanel>

        <!-- Staff -->
        <MudTabPanel Text="Staff" Icon="@Icons.Material.Filled.ManageAccounts">
            @if (_editionRessources)
            {
                @* #29 — Saisie libre : trésorerie et staff à la main, tracés. *@
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4" md="3">
                        <MudNumericField T="int" @bind-Value="_editTresorerie" Label="Trésorerie (po)"
                                         Min="0" Max="@SaisieLibreRegles.TresorerieMax" Step="10000"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    @foreach (var st in _staffLigue)
                    {
                        <MudItem xs="6" sm="4" md="2">
                            <MudNumericField T="int" Value="@_editStaff.GetValueOrDefault(st.Id)"
                                             ValueChanged="@(v => _editStaff[st.Id] = Math.Max(0, v))"
                                             Label="@st.Nom" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    }
                </MudGrid>
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-2">
                    <MudButton Variant="Variant.Text" OnClick="@(() => _editionRessources = false)">Annuler</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@_editionRessourcesEnCours"
                               StartIcon="@Icons.Material.Filled.Check" OnClick="EnregistrerRessources">Enregistrer</MudButton>
                </MudStack>
            }
            else
            {
                @if (_peutEditerLibre)
                {
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       title="Modifier la trésorerie et le staff" aria-label="Modifier le staff"
                                       OnClick="@(() => DemarrerRessources(versOnglet: false))" />
                    </MudStack>
                }
                <MudGrid>
                    @foreach (var (label, valeur) in StaffItems())
                    {
                        <MudItem xs="6" sm="4" md="2">
                            <MudPaper Elevation="1" Class="pa-3 text-center">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@label</MudText>
                                <MudText Typo="Typo.h5"><b>@valeur</b></MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudTabPanel>

        <!-- Statistiques -->
        <MudTabPanel Text="Stats" Icon="@Icons.Material.Filled.QueryStats">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle2" Class="mb-3"><b>Performances d'équipe</b></MudText>
                        @foreach (var (label, valeur, color) in TeamStats())
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                                <MudText>@label</MudText>
                                <MudText Color="@color"><b>@valeur</b></MudText>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTable Items="@_equipe.Joueurs.OrderByDescending(j => j.PointsStarPlayer)"
                             Dense="true" Elevation="1">
                        <ToolBarContent>
                            <MudText Typo="Typo.subtitle2"><b>PSP par joueur</b></MudText>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Joueur</MudTh>
                            <MudTh Style="text-align:center">PSP</MudTh>
                            <MudTh Style="text-align:center">Amél.</MudTh>
                            @if (_estCommissaire)
                            {
                                <MudTh Style="text-align:center"></MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate Context="j">
                            <MudTd DataLabel="N°">@j.Numero</MudTd>
                            <MudTd DataLabel="Joueur">@j.Nom</MudTd>
                            <MudTd DataLabel="PSP" Style="text-align:center"><b>@j.PointsStarPlayer</b></MudTd>
                            <MudTd DataLabel="Améliorations" Style="text-align:center">@j.Improvements.Count</MudTd>
                            @if (_estCommissaire)
                            {
                                <MudTd DataLabel="Action" Style="text-align:center">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditNote" Size="Size.Small"
                                                   title="Corriger les PSP de ce joueur"
                                                   OnClick="@(() => CorrigerXp(j))" />
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* #29 — Saisie libre : qui a modifié quoi. Réservé au commissaire. *@
        @if (_historiqueVisible)
        {
            <MudTabPanel Text="Historique" Icon="@Icons.Material.Filled.History">
                @if (_historique.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Aucune modification libre.</MudText>
                }
                else
                {
                    <MudTable Items="_historique" Dense="true" Elevation="1" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh>Par</MudTh>
                            <MudTh>Quoi</MudTh>
                            <MudTh>Avant → après</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="h">
                            <MudTd DataLabel="Date">@h.modif.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                            <MudTd DataLabel="Par">@h.auteur</MudTd>
                            <MudTd DataLabel="Quoi">@(h.modif.Sujet == "Équipe" ? h.modif.Champ : $"{h.modif.Sujet} · {h.modif.Champ}")</MudTd>
                            <MudTd DataLabel="Avant → après">@h.modif.Avant → @h.modif.Apres</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>
        }
    </MudTabs>

    @* Fiche d'une compétence, ouverte au clic sur son nom. Un attribut `title`
       ne répondrait qu'au survol souris : inaccessible au doigt. *@
    @if (_competenceAffichee is { } comp)
    {
        <div class="skill-overlay-backdrop" @onclick="FermerCompetence">
            <div @onclick:stopPropagation="true">
                <MudPaper Class="skill-overlay-card" Elevation="8">
                    <div class="skill-overlay-head">
                        <MudText Typo="Typo.h6"><b>@comp.Nom</b></MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       OnClick="FermerCompetence" aria-label="Fermer" />
                    </div>
                    @if (comp.EstTrait || comp.EstElite)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                            @(comp.EstTrait ? "Trait" : null)@(comp.EstTrait && comp.EstElite ? " · " : null)@(comp.EstElite ? "Élite" : null)
                        </MudText>
                    }
                    <MudText Typo="Typo.body2" Class="skill-overlay-desc">@comp.Description</MudText>
                    <MudText Typo="Typo.caption" Class="skill-overlay-hint">Touchez à côté pour fermer</MudText>
                </MudPaper>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    Team? _equipe;
    int _vea;
    string _userId = "";
    bool _estCommissaire;

    /// <summary>
    /// Mode brouillard : la fiche du prochain adversaire est masquée, pour que
    /// le coach ne prépare pas sa rencontre en étudiant l'effectif d'en face.
    /// Le contrôle est fait au chargement (serveur), pas seulement à l'affichage.
    /// </summary>
    bool _masqueeParBrouillard;

    /// <summary>Divinités que la race autorise (« Favori de… »). Vide = non concernée.</summary>
    List<string> _optionsDivinite = [];

    // ── Capitaine ───────────────────────────────────────────────────────────

    /// <summary>Vrai si l'utilisateur courant est le coach de cette équipe.</summary>
    bool _estCoach;

    // ── Modifier un joueur : crayon en bout de ligne, édition sur la ligne ───
    //
    // Volontairement DÉCORRÉLÉ de _peutEditer : celui-ci ouvre l'écran de
    // composition, qui supprime et recrée tout le roster — d'où son verrou en
    // phase Inscription. Le nom et les Haines n'entrent dans aucun calcul : ils
    // se modifient à tout moment, y compris sur un joueur mort ou retraité.
    // Coach de l'équipe et commissaire de la ligue ; le service le revérifie.
    bool _peutEditerJoueurs;
    List<string> _suggestionsHaine = [];

    // Traits « Haine (…) » du catalogue : pour tout le monde, juste pour
    // rendre une Haine cliquable quand la version la décrit.
    Dictionary<string, Skill> _traitsHaineCatalogue = new(StringComparer.OrdinalIgnoreCase);

    // Édition EN PLACE sur la ligne : le crayon passe la ligne en édition
    // (nom, capitaine, Haines), ✓ enregistre, ✕ annule. Une ligne à la fois.
    int? _editionJoueurId;
    string _editionNom = "";
    List<string> _editionHaines = [];
    bool _editionCapitaine;
    string? _editionSaisie;
    bool _editionEnCours;
    SelecteurHaine? _selecteurEdition;

    // Le crayon de la ligne en édition reste allumé ; un second clic referme.
    RenderFragment CrayonJoueur(TeamPlayer j) =>
        _editionJoueurId == j.Id
            ? @<MudIconButton Icon="@Icons.Material.Filled.EditOff" Size="Size.Small" Color="Color.Primary"
                              title="Fermer sans enregistrer" aria-label="Fermer l'édition" OnClick="AnnulerEdition" />
            : @<MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                              title="Modifier le joueur" aria-label="Modifier le joueur"
                              OnClick="@(() => DemarrerEdition(j))" />;

    /// <summary>
    /// Panneau d'édition, sous la ligne : un seul bloc, en sections titrées
    /// (Joueur, Haines, puis en saisie libre Progression, Compétences,
    /// Caractéristiques, Blessures), boutons en bas. Rien n'est écrit avant
    /// « Enregistrer ».
    /// </summary>
    RenderFragment PanneauEdition(TeamPlayer j) =>
        @<MudPaper Outlined="true" Class="pa-3 panneau-edition">
            <MudText Typo="Typo.subtitle2" Class="mb-3">
                <b>Modifier #@j.Numero</b>
                <span style="color:var(--mud-palette-text-secondary)"> · @j.PlayerPosition?.Nom</span>
            </MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    @TitreSection("Joueur")
                    @ChampNom(j)
                </MudItem>
                <MudItem xs="12" md="6">
                    @TitreSection("Haines")
                    @EditionHaines(j)
                </MudItem>
            </MudGrid>
            @if (_libre)
            {
                <MudDivider Class="my-3" />
                @EditionLibre(j)
            }
            <MudDivider Class="my-3" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-none d-sm-flex">
                    Entrée dans le nom : enregistrer · Échap : annuler
                </MudText>
                <MudStack Row="true" Spacing="2" Class="ml-auto">
                    <MudButton Variant="Variant.Text" OnClick="AnnulerEdition" aria-label="Annuler">Annuler</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                               Disabled="@_editionEnCours" OnClick="EnregistrerEdition" aria-label="Enregistrer">Enregistrer</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>;

    static RenderFragment TitreSection(string titre) =>
        @<MudText Typo="Typo.overline" Color="Color.Secondary" Class="d-block mb-1" Style="line-height:1.6">@titre</MudText>;

    /// <summary>« Aucune » quand la liste est vide : la section garde sa forme.</summary>
    static RenderFragment AucunSiVide(bool vide) =>
        @<span>@if (vide) { <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">Aucune</MudText> }</span>;

    /// <summary>
    /// Nom en édition, et la case « Capitaine » quand la race a la règle et que
    /// le joueur est dans l'effectif (un mort ou un retraité ne l'est pas).
    /// </summary>
    RenderFragment ChampNom(TeamPlayer j) =>
        @<div>
            <MudTextField T="string" Value="@_editionNom" ValueChanged="@(v => _editionNom = v)"
                          Immediate="true" AutoFocus="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Label="Nom" HelperText="Vide = numéro de maillot"
                          MaxLength="@JoueurEditionService.NomLongueurMax" OnKeyDown="ToucheEdition" />
            @if (CapitaineEditable(j))
            {
                <MudCheckBox T="bool" Value="_editionCapitaine" ValueChanged="@(v => _editionCapitaine = v)"
                             Label="Capitaine" Size="Size.Small" Dense="true" Color="Color.Warning" />
            }
        </div>;

    bool CapitaineEditable(TeamPlayer j) =>
        CapitaineHelper.RaceAUnCapitaine(_equipe?.TeamType) && !j.EstMort && !j.EstRetraite;

    /// <summary>
    /// Haines de la ligne en édition : pastilles à croix + champ d'ajout (texte
    /// libre, suggestions des mots-clés de la version). Un mort peut en perdre,
    /// pas en gagner.
    /// </summary>
    RenderFragment EditionHaines(TeamPlayer j) =>
        @<div>
            @AucunSiVide(_editionHaines.Count == 0)
            @foreach (var h in _editionHaines)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                         OnClose="@(_ => _editionHaines.Remove(h))">@HaineHelpers.Libelle(h)</MudChip>
            }
            @if (!j.EstMort)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                    <SelecteurHaine @ref="_selecteurEdition" Suggestions="_suggestionsHaine"
                                    Value="@_editionSaisie" ValueChanged="@(v => _editionSaisie = v)"
                                    Label="Ajouter une Haine" OnEntree="AjouterHaineEdition" />
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small"
                                   title="Ajouter la Haine" aria-label="Ajouter la Haine" OnClick="AjouterHaineEdition" />
                </MudStack>
            }
        </div>;

    void DemarrerEdition(TeamPlayer j)
    {
        _editionJoueurId = j.Id;
        _editionNom = j.Nom;
        _editionHaines = HaineHelpers.Liste(j.Haines);
        _editionCapitaine = j.EstCapitaine;
        _editionSaisie = null;
        if (_libre) DemarrerProgression(j);
    }

    void AnnulerEdition() => _editionJoueurId = null;

    async Task ToucheEdition(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await EnregistrerEdition();
        else if (e.Key == "Escape") AnnulerEdition();
    }

    /// <summary>Ajoute la saisie à la liste de la ligne ; rien n'est enregistré avant ✓.</summary>
    async Task AjouterHaineEdition()
    {
        try
        {
            var cible = HaineHelpers.Normaliser(_editionSaisie);
            if (cible is null) return;
            if (!HaineHelpers.Contient(HaineHelpers.Joindre(_editionHaines), cible))
                _editionHaines.Add(cible);
            _editionSaisie = null;
            // Remettre la valeur à null ne vide pas un champ qui a le focus.
            if (_selecteurEdition is not null) await _selecteurEdition.ViderAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    async Task EnregistrerEdition()
    {
        if (_editionJoueurId is not int joueurId || _editionEnCours) return;
        // Une Haine tapée mais pas encore ajoutée compte : sinon ✓ la perdrait.
        var haines = string.IsNullOrWhiteSpace(_editionSaisie)
            ? _editionHaines : _editionHaines.Append(_editionSaisie).ToList();
        _editionEnCours = true;
        try
        {
            var joueur = _equipe?.Joueurs.FirstOrDefault(p => p.Id == joueurId);
            bool? capitaine = joueur is not null && CapitaineEditable(joueur) ? _editionCapitaine : null;
            if (_libre)
                await SaisieLibre.ModifierJoueurAsync(joueurId, _userId, _editionNom, haines, capitaine, ProgressionVoulue());
            else
                await JoueurEdition.ModifierJoueurAsync(joueurId, _userId, _editionNom, haines, capitaine);
            // Relire l'état réel : le service a pu substituer le numéro de
            // maillot à un nom vide, ou normaliser une Haine. En saisie libre,
            // la valeur du joueur (et donc la VEA) a pu changer.
            _equipe = await TeamService.GetEquipeAsync(Id);
            if (_equipe is not null) _vea = TeamService.CalculerVEA(_equipe);
            await ChargerHistoriqueAsync();
            _editionJoueurId = null;
            Snackbar.Add("Joueur modifié.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally { _editionEnCours = false; }
    }

    /// <summary>Compétence que le titre accorde, telle que paramétrée par race.</summary>
    string? CompetenceDuCapitaine()
    {
        var lien = _equipe?.TeamType?.ReglesSpecialesListe
            .FirstOrDefault(l => l.SpecialRule?.Code == SpecialRuleCodes.CompetenceAuCapitaine);
        var valeurs = SpecialRuleCodes.DecouperOptions(lien?.OptionsChoix);
        return valeurs.Length > 0 ? valeurs[0] : null;
    }

    /// <summary>Rappelle la compétence effectivement offerte au capitaine.</summary>
    string HelperCapitaine()
    {
        var c = CompetenceDuCapitaine();
        return c is null
            ? "Aucune compétence paramétrée par le commissaire."
            : $"Le capitaine gagne « {c} ».";
    }

    /// <summary>Règles spéciales de la race, dans l'ordre d'affichage.</summary>
    List<TeamTypeSpecialRule> _reglesSpeciales =>
        _equipe?.TeamType?.ReglesSpecialesListe
            .Where(l => l.SpecialRule is not null)
            .OrderBy(l => l.SpecialRule.Ordre).ThenBy(l => l.SpecialRule.Nom)
            .ToList() ?? [];

    bool _peutEditer =>
        _equipe is not null
        && _equipe.CoachId == _userId
        && _equipe.League is not null
        && DisplayHelpers.InscriptionOuverte(_equipe.League.Statut, _equipe.League.Format);

    /// <summary>
    /// Choix du Dieu du Chaos par le commissaire. Le service revalide contre les
    /// options de la race : l'écran ne fait pas autorité.
    /// </summary>
    async Task DefinirDivinite(string divinite)
    {
        if (_equipe is null) return;
        try
        {
            await TeamService.DefinirDiviniteAsync(_equipe.Id, divinite);
            _equipe = await TeamService.GetEquipeAsync(Id);   // relit l'état réel
            Snackbar.Add(
                string.IsNullOrEmpty(divinite) ? "Divinité effacée" : $"Divinité : {divinite}",
                Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";

        _equipe = await TeamService.GetEquipeAsync(Id);
        if (_equipe is not null)
        {
            _vea = TeamService.CalculerVEA(_equipe);
            _optionsDivinite = await TeamService.GetOptionsDiviniteAsync(_equipe.TeamTypeId);
        }

        // Correction d'PSP (R4) : réservée au commissaire de la ligue et aux grands commissaires.
        _estCommissaire = authState.User.IsInRole("Commissaire")
                       || authState.User.IsInRole("GrandCommissaire")
                       || authState.User.IsInRole("Admin")
                       || (_equipe?.League?.CommissaireId is { } cid && cid == _userId);

        // Le capitaine est désigné par le COACH de l'équipe (choix produit),
        // contrairement au Dieu du Chaos réservé au commissaire.
        _estCoach = _equipe?.CoachId == _userId;

        // Crayon « Modifier le joueur » : le coach, et le commissaire de la ligue.
        // Le service refait la vérification ; ceci ne fait qu'afficher le crayon.
        if (_equipe?.League is { } ligueHaine)
        {
            _traitsHaineCatalogue = await HaineService.GetTraitsCatalogueAsync(ligueHaine.RulesVersionId);
            _peutEditerJoueurs = _estCoach || await Auth.PeutGererLigueAsync(_userId, ligueHaine.Id);
            if (_peutEditerJoueurs)
                _suggestionsHaine = await HaineService.GetSuggestionsAsync(ligueHaine.RulesVersionId);
            if (_peutEditerJoueurs && ligueHaine.SaisieLibre)
                _competencesVersion = await TeamService.GetCompetencesAsync(null, ligueHaine.RulesVersionId);
            _historiqueVisible = ligueHaine.SaisieLibre && await Auth.PeutGererLigueAsync(_userId, ligueHaine.Id);
            await ChargerHistoriqueAsync();
        }

        // Mode brouillard : masquer la fiche du prochain adversaire.
        if (_equipe?.League is { ModeBrouillard: true } ligue && !_estCommissaire)
        {
            var mesEquipes = (await TeamService.GetEquipesLigueAsync(ligue.Id))
                .Where(e => e.CoachId == _userId)
                .Select(e => e.Id)
                .ToHashSet();

            if (mesEquipes.Count > 0)
            {
                var matchs = await MatchService.GetMatchsLigueAsync(ligue.Id);
                _masqueeParBrouillard = !BrouillardHelpers.PeutVoirFicheEquipe(
                    Id, matchs, mesEquipes, ligue.ModeBrouillard, _estCommissaire);
            }
        }
    }

    async Task CorrigerXp(TeamPlayer joueur)
    {
        var parameters = new DialogParameters<CorrectionPspDialog>
        {
            { x => x.Joueur, joueur },
            { x => x.CommissaireId, _userId }
        };
        var dialog = await DialogService.ShowAsync<CorrectionPspDialog>(
            "Corriger les PSP", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            _equipe = await TeamService.GetEquipeAsync(Id);
            if (_equipe is not null)
                _vea = TeamService.CalculerVEA(_equipe);
            StateHasChanged();
        }
    }

    async Task ConfirmerSuppression()
    {
        if (_equipe is null) return;
        var result = await DialogService.ShowMessageBox(
            "Supprimer l'équipe",
            $"Êtes-vous sûr de vouloir supprimer « {_equipe.Nom} » ? Cette action est irréversible.",
            yesText: "Supprimer", cancelText: "Annuler");
        if (result != true) return;

        try
        {
            await TeamService.SupprimerEquipeAsync(_equipe.Id, _userId);
            Snackbar.Add("Équipe supprimée.", Severity.Success);
            Nav.NavigateTo("/profil");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    static string InjuryCellStyle(int mod) =>
        mod < 0 ? "text-align:center; background-color:rgba(229,57,53,0.18); border-radius:4px" : "text-align:center";

    static string StatInt(int baseVal, int mod) =>
        mod == 0 ? baseVal.ToString() : $"{baseVal + mod} ({(mod > 0 ? "+" : "")}{mod})";

    static string StatStr(string baseVal, int mod, bool plusEstMieux)
    {
        if (baseVal == "-" || mod == 0) return baseVal;
        if (!int.TryParse(baseVal.TrimEnd('+'), out var n)) return baseVal;
        var effective = plusEstMieux ? n + mod : n - mod;
        var sign = (plusEstMieux ? mod : -mod) > 0 ? "+" : "";
        var delta = plusEstMieux ? mod : -mod;
        return $"{effective}+ ({sign}{delta})";
    }

    static string SeqquellesSummary(TeamPlayer j)
    {
        var parts = new List<string>();
        if (j.ModMouvement < 0)     parts.Add($"MA{j.ModMouvement}");
        if (j.ModForce < 0)         parts.Add($"F{j.ModForce}");
        if (j.ModAgilite < 0)       parts.Add($"AG{j.ModAgilite}");
        if (j.ModCapacitePasse < 0) parts.Add($"CP{j.ModCapacitePasse}");
        if (j.ModArmure < 0)        parts.Add($"AV{j.ModArmure}");
        return parts.Count > 0 ? $"({string.Join(", ", parts)})" : "";
    }

    /// <summary>
    /// Noms de compétences cliquables. On n'utilise PAS l'attribut `title` :
    /// il ne répond qu'au survol souris, donc l'explication était inaccessible
    /// sur téléphone — or c'est là que les coaches consultent leur feuille
    /// pendant un tournoi. Un clic ouvre la fiche, comme sur l'écran de choix
    /// de race qui règle déjà le problème de cette façon.
    /// </summary>
    RenderFragment CompetencesJoueur(TeamPlayer j, bool avecHaines = true) => builder =>
    {
        var skills = (j.PlayerPosition?.CompetencesDepart.Select(c => c.Skill) ?? [])
            .Concat(j.Competences.Where(c => !c.EstCompetenceDepart).Select(c => c.Skill))
            .Where(s => s is not null)
            .Cast<Skill>()
            .ToList();
        for (int i = 0; i < skills.Count; i++)
        {
            var sk = skills[i];
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "skill-link");
            builder.AddAttribute(2, "onclick",
                EventCallback.Factory.Create<MouseEventArgs>(this, () => OuvrirCompetence(sk)));
            builder.AddContent(3, sk.Nom);
            builder.CloseElement();
            if (i < skills.Count - 1)
                builder.AddMarkupContent(4, ", ");
        }

        // Compétence du capitaine : calculée, jamais stockée — elle suit donc le
        // titre sans nettoyage. Signalée comme telle pour que le coach sache
        // qu'elle disparaîtra s'il change de capitaine.
        var offerte = CapitaineHelper.CompetenceOfferte(j, _equipe?.TeamType);
        if (offerte is not null)
        {
            if (skills.Count > 0) builder.AddMarkupContent(5, ", ");
            builder.OpenElement(6, "span");
            builder.AddAttribute(7, "style", "color:var(--mud-palette-warning)");
            builder.AddAttribute(8, "title", "Accordée par le titre de capitaine");
            builder.AddContent(9, offerte + " (capitaine)");
            builder.CloseElement();
        }

        // Haines gagnées (#28) : texte sur le joueur. Cliquable seulement si le
        // catalogue de la version décrit ce Trait ; sinon simple texte.
        var haines = avecHaines ? HaineHelpers.Liste(j.Haines) : [];
        for (int i = 0; i < haines.Count; i++)
        {
            if (skills.Count > 0 || offerte is not null || i > 0) builder.AddMarkupContent(10, ", ");
            var libelle = HaineHelpers.Libelle(haines[i]);
            builder.OpenElement(11, "span");
            if (_traitsHaineCatalogue.TryGetValue(libelle, out var trait))
            {
                builder.AddAttribute(12, "class", "skill-link");
                builder.AddAttribute(13, "onclick",
                    EventCallback.Factory.Create<MouseEventArgs>(this, () => OuvrirCompetence(trait)));
            }
            builder.AddContent(14, libelle);
            builder.CloseElement();
        }
    };

    Skill? _competenceAffichee;
    void OuvrirCompetence(Skill s) => _competenceAffichee = s;
    void FermerCompetence() => _competenceAffichee = null;

    // ── #29 Saisie libre : trésorerie et staff modifiables à tout moment ─────
    bool _libre => _equipe?.League?.SaisieLibre == true;
    bool _peutEditerLibre => _libre && _peutEditerJoueurs;

    // Lot 2 : progression du joueur, dans le panneau ouvert sous la ligne en
    // édition. Copie de travail ; rien n'est écrit avant ✓.
    int _editionPsp;
    bool _editionRpm;
    List<int> _editionCompetences = [];
    List<AffectedStat> _editionCarac = [];
    List<BlessureLibre> _editionBlessures = [];
    string? _saisieCompetence;
    SelecteurHaine? _selecteurCompetence;
    List<Skill> _competencesVersion = [];

    static readonly AffectedStat[] Stats =
        [AffectedStat.Mouvement, AffectedStat.Force, AffectedStat.Agilite, AffectedStat.CapacitePasse, AffectedStat.Armure];

    void DemarrerProgression(TeamPlayer j)
    {
        _editionPsp = j.PointsStarPlayer;
        _editionRpm = j.ManqueSuivantMatch;
        _editionCompetences = j.Improvements.Where(i => i.SkillId is not null).Select(i => i.SkillId!.Value).ToList();
        _editionCarac = j.Improvements.Where(i => i.SkillId is null && i.StatAmelioree is not null)
            .Select(i => i.StatAmelioree!.Value).ToList();
        _editionBlessures = j.Blessures.Where(b => SaisieLibreService.BlessuresDurables.Contains(b.Type))
            .Select(b => new BlessureLibre(b.Id, b.Type, b.StatAffectee)).ToList();
        _saisieCompetence = null;
    }

    ProgressionLibre ProgressionVoulue() =>
        new(_editionPsp, _editionRpm, _editionCompetences, _editionCarac, _editionBlessures);

    string NomCompetence(int id) => _competencesVersion.FirstOrDefault(s => s.Id == id)?.Nom ?? "?";

    IReadOnlyList<string> SuggestionsCompetence(TeamPlayer j)
    {
        // Compétences du POSTE : GetEquipeAsync ne charge que les acquises dans
        // j.Competences, on passe donc par le poste.
        var exclues = (j.PlayerPosition?.CompetencesDepart.Select(c => c.SkillId) ?? [])
            .Concat(_editionCompetences).ToHashSet();
        return _competencesVersion.Where(s => !exclues.Contains(s.Id)).Select(s => s.Nom).ToList();
    }

    async Task AjouterCompetenceEdition()
    {
        var nom = _saisieCompetence?.Trim();
        if (string.IsNullOrEmpty(nom)) return;
        var skill = _competencesVersion.FirstOrDefault(s => string.Equals(s.Nom, nom, StringComparison.OrdinalIgnoreCase));
        if (skill is null)
        {
            Snackbar.Add($"« {nom} » n'existe pas dans cette version des règles.", Severity.Warning);
            return;
        }
        if (!_editionCompetences.Contains(skill.Id)) _editionCompetences.Add(skill.Id);
        _saisieCompetence = null;
        if (_selecteurCompetence is not null) await _selecteurCompetence.ViderAsync();
    }

    /// <summary>
    /// Panneau de la saisie libre, sous la ligne en édition : ce que
    /// l'après-match fait d'habitude, à la main. Retirer une pastille inverse
    /// son effet (une Séquelle rend sa caractéristique, Mort ramène le joueur).
    /// </summary>
    RenderFragment EditionLibre(TeamPlayer j) =>
        @<div class="edition-libre">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6" lg="3">
                    @TitreSection("Progression")
                    <MudNumericField T="int" @bind-Value="_editionPsp" Label="PSP disponibles" Min="0"
                                     Max="@SaisieLibreService.PspMax" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudCheckBox T="bool" @bind-Value="_editionRpm" Label="Rate le prochain match"
                                 Size="Size.Small" Dense="true" Color="Color.Warning" />
                </MudItem>
                <MudItem xs="12" sm="6" lg="3">
                    @TitreSection("Compétences acquises")
                    @AucunSiVide(_editionCompetences.Count == 0)
                    @foreach (var id in _editionCompetences.ToList())
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                 OnClose="@(_ => _editionCompetences.Remove(id))">@NomCompetence(id)</MudChip>
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                        <SelecteurHaine @ref="_selecteurCompetence" Suggestions="SuggestionsCompetence(j)"
                                        Value="@_saisieCompetence" ValueChanged="@(v => _saisieCompetence = v)"
                                        Label="Ajouter une compétence" Placeholder="ex. Garde" OnEntree="AjouterCompetenceEdition" />
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small"
                                       title="Ajouter la compétence" aria-label="Ajouter la compétence" OnClick="AjouterCompetenceEdition" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6" lg="3">
                    @TitreSection("Caractéristiques")
                    @AucunSiVide(_editionCarac.Count == 0)
                    @foreach (var (stat, i) in _editionCarac.Select((s, i) => (s, i)).ToList())
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                 OnClose="@(_ => _editionCarac.RemoveAt(i))">+1 @BlessureHelpers.AbregeStat(stat)</MudChip>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Ajouter +1</MudText>
                    <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">
                        @foreach (var st in Stats)
                        {
                            <MudButton Style="min-width:40px"
                                       title="@($"+1 {BlessureHelpers.LibelleStat(st)}")" aria-label="@($"+1 {BlessureHelpers.AbregeStat(st)}")"
                                       OnClick="@(() => _editionCarac.Add(st))">@BlessureHelpers.AbregeStat(st)</MudButton>
                        }
                    </MudButtonGroup>
                </MudItem>
                <MudItem xs="12" sm="6" lg="3">
                    @TitreSection("Blessures")
                    @AucunSiVide(_editionBlessures.Count == 0)
                    @foreach (var (b, i) in _editionBlessures.Select((b, i) => (b, i)).ToList())
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                 OnClose="@(_ => _editionBlessures.RemoveAt(i))">@BlessureHelpers.Resume(b.Type, b.Stat)</MudChip>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Ajouter</MudText>
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                   title="Blessure sérieuse : une BP (+1 aux jets d'élimination)" aria-label="Ajouter une BP"
                                   OnClick="@(() => _editionBlessures.Add(new(null, InjuryType.BlessurePersistante)))">BP</MudButton>
                        @if (!_editionBlessures.Any(b => b.Type == InjuryType.Mort))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" aria-label="Ajouter Mort"
                                       OnClick="@(() => _editionBlessures.Add(new(null, InjuryType.Mort)))">Mort</MudButton>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Séquelle (−1)</MudText>
                    <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">
                        @foreach (var st in Stats)
                        {
                            <MudButton Style="min-width:40px"
                                       title="@($"Séquelle : −1 {BlessureHelpers.LibelleStat(st)}")" aria-label="@($"Séquelle −1 {BlessureHelpers.AbregeStat(st)}")"
                                       OnClick="@(() => _editionBlessures.Add(new(null, InjuryType.Sequelle, st)))">@BlessureHelpers.AbregeStat(st)</MudButton>
                        }
                    </MudButtonGroup>
                </MudItem>
            </MudGrid>
        </div>;
    bool _editionRessources;
    bool _editionRessourcesEnCours;
    int _editTresorerie;
    Dictionary<int, int> _editStaff = [];
    List<LeagueStaffType> _staffLigue = [];
    int _ongletActif;
    const int OngletStaff = 1;
    bool _historiqueVisible;
    List<(ModificationLibre modif, string auteur)> _historique = [];

    async Task ChargerHistoriqueAsync()
    {
        if (_historiqueVisible) _historique = await SaisieLibre.GetHistoriqueAfficheAsync(Id, _userId);
    }

    async Task DemarrerRessources(bool versOnglet)
    {
        if (_equipe is null) return;
        // Tout le staff proposé par la ligue, pas seulement celui détenu : on
        // doit pouvoir passer un apothicaire de 0 à 1.
        _staffLigue = await StaffService.GetStaffLigueAsync(_equipe.LeagueId, actifsSeulement: true);
        _editStaff = _staffLigue.ToDictionary(s => s.Id,
            s => _equipe.Staff.FirstOrDefault(x => x.LeagueStaffTypeId == s.Id)?.Quantite ?? 0);
        _editTresorerie = _equipe.Tresorerie;
        _editionRessources = true;
        if (versOnglet) _ongletActif = OngletStaff;
    }

    async Task EnregistrerRessources()
    {
        if (_editionRessourcesEnCours) return;
        _editionRessourcesEnCours = true;
        try
        {
            await SaisieLibre.ModifierRessourcesEquipeAsync(Id, _userId, _editTresorerie, _editStaff);
            _equipe = await TeamService.GetEquipeAsync(Id);
            if (_equipe is not null) _vea = TeamService.CalculerVEA(_equipe);
            await ChargerHistoriqueAsync();
            _editionRessources = false;
            Snackbar.Add("Trésorerie et staff enregistrés.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally { _editionRessourcesEnCours = false; }
    }

    IEnumerable<(string, string)> StaffItems()
    {
        if (_equipe is null) yield break;

        // Boucle sur le staff réellement détenu : un staff créé par l'association
        // (« Chef de bande »…) doit apparaître ici sans modification de code.
        // Repli sur les colonnes historiques pour une équipe pas encore migrée.
        var staff = _equipe.Staff
            .Where(s => s.LeagueStaffType is not null)
            .OrderBy(s => s.LeagueStaffType.Ordre)
            .ThenBy(s => s.LeagueStaffType.Nom)
            .ToList();

        if (staff.Count == 0)
        {
            yield return ("Relances", _equipe.NombreRelances.ToString());
            yield return ("Fans dévoués", _equipe.FansDevoues.ToString());
            yield return ("Coachs ass.", _equipe.NombreCoachsAssistants.ToString());
            yield return ("Cheerleaders", _equipe.NombreCheerleaders.ToString());
            yield return ("Apothicaire", _equipe.Apothicaire ? "Oui" : "Non");
            yield break;
        }

        foreach (var s in staff)
        {
            // Un staff plafonné à 1 est un oui/non, pas un compteur.
            var valeur = s.LeagueStaffType.MaxCreation == 1 && s.LeagueStaffType.MaxLigue == 1
                ? (s.Quantite > 0 ? "Oui" : "Non")
                : s.Quantite.ToString();
            yield return (s.LeagueStaffType.Nom, valeur);
        }
    }

    IEnumerable<(string, string, Color)> TeamStats()
    {
        if (_equipe is null) yield break;
        yield return ("Matchs joués", _equipe.NombreMatchsJoues.ToString(), Color.Default);
        yield return ("Touchdowns marqués", _equipe.TouchdownsMarques.ToString(), Color.Success);
        yield return ("Touchdowns concédés", _equipe.TouchdownsConcedes.ToString(), Color.Error);
        yield return ("Éliminations infligées", _equipe.EliminationsInfligees.ToString(), Color.Warning);
        yield return ("Points de ligue", _equipe.PointsLigue.ToString(), Color.Primary);
    }
}
