@page "/profil"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager
@inject GmailEmailSender EmailSender
@inject TeamService TeamService
@inject LeagueService LeagueService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject UserAccountService UserAccountService
@inject AbonnementCalendrierService Abonnement
@inject BolDeSangManager.Services.IAuthorizationService Auth

<PageTitle>Mon Profil — BolDeSang Manager</PageTitle>

<MudText Typo="Typo.h5" Color="Color.Error" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="mr-2" />
    <b>Mon Profil</b>
</MudText>

@if (_user is null)
{
    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
}
else
{
    <MudGrid Spacing="3">

        <!-- Carte identité -->
        <MudItem xs="12" sm="5" md="4">
            <MudCard Elevation="2">
                <MudCardContent Class="d-flex flex-column align-center pa-6">
                    <MudAvatar Style="width:80px;height:80px;font-size:2.5rem;background:#e53935;color:#fff" Class="mb-3">
                        @((_user.PseudoCoach?.Length > 0 ? _user.PseudoCoach : (_user.UserName ?? "?"))[0])
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Class="mb-1"><b>@(_user.PseudoCoach?.Length > 0 ? _user.PseudoCoach : _user.UserName)</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@_user.Email</MudText>
                    @if (_estCommissaire)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Star">
                            Commissaire
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small" Icon="@Icons.Material.Filled.SportsScore">
                            Coach
                        </MudChip>
                    }
                </MudCardContent>
            </MudCard>

            <!-- Modifier le pseudo -->
            <MudCard Elevation="2" Class="mt-3">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle1" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Class="mr-1" Size="Size.Small" />
                        <b>Pseudo</b>
                    </MudText>
                    <MudTextField @bind-Value="_pseudoEdit"
                                  Label="Pseudo affiché"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Disabled="@_savingPseudo" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
                               OnClick="ChangerPseudo" Disabled="@_savingPseudo"
                               StartIcon="@Icons.Material.Filled.Save">
                        @(_savingPseudo ? "Enregistrement…" : "Enregistrer")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Colonne droite -->
        <MudItem xs="12" sm="7" md="8">

            <!-- Statistiques -->
            <MudCard Elevation="2" Class="mb-3">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle1" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-1" Size="Size.Small" />
                        <b>Statistiques</b>
                    </MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="3">
                            <div class="text-center">
                                <MudText Typo="Typo.h4" Color="Color.Error"><b>@(_equipes?.Count ?? 0)</b></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Équipes</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <div class="text-center">
                                <MudText Typo="Typo.h4" Color="Color.Error">
                                    <b>@(_equipes?.Sum(e => e.NombreMatchsJoues) ?? 0)</b>
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Matchs joués</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <div class="text-center">
                                <MudText Typo="Typo.h4" Color="Color.Success">
                                    <b>@(_equipes?.Sum(e => e.NombreVictoires) ?? 0)</b>
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Victoires</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <div class="text-center">
                                <MudText Typo="Typo.h4" Color="Color.Error">
                                    <b>@(_equipes?.Sum(e => e.TouchdownsMarques) ?? 0)</b>
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Touchdowns</MudText>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- Changer l'adresse email -->
            <MudCard Elevation="2" Class="mb-3">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle1" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.AlternateEmail" Class="mr-1" Size="Size.Small" />
                        <b>Adresse email</b>
                    </MudText>
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        Votre adresse email vous sert aussi d'identifiant de connexion.
                        Un lien de confirmation sera envoyé à la <b>nouvelle</b> adresse : tant que vous
                        n'avez pas cliqué dessus, rien ne change. Une fois confirmée, vous devrez vous
                        reconnecter avec la nouvelle adresse.
                    </MudAlert>
                    <MudTextField Value="@_user.Email" Label="Adresse actuelle"
                                  Variant="Variant.Outlined" FullWidth="true" Class="mb-2"
                                  ReadOnly="true" Disabled="true" T="string" />
                    <MudTextField @bind-Value="_nouvelEmail"
                                  Label="Nouvelle adresse email"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Disabled="@_changingEmail" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               OnClick="ChangerEmail" Disabled="@_changingEmail"
                               StartIcon="@Icons.Material.Filled.Send">
                        @(_changingEmail ? "Envoi…" : "Envoyer le lien de confirmation")
                    </MudButton>
                </MudCardActions>
            </MudCard>

            <!-- Changer le mot de passe -->
            <MudCard Elevation="2" Class="mb-3">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle1" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-1" Size="Size.Small" />
                        <b>Changer le mot de passe</b>
                    </MudText>
                    <MudTextField @bind-Value="_ancienMdp"
                                  Label="Mot de passe actuel"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Class="mb-2"
                                  Disabled="@_changingPassword" />
                    <MudTextField @bind-Value="_nouveauMdp"
                                  Label="Nouveau mot de passe"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Class="mb-2"
                                  HelperText="8 caractères minimum, au moins un chiffre"
                                  Disabled="@_changingPassword" />
                    <MudTextField @bind-Value="_confirmMdp"
                                  Label="Confirmer le nouveau mot de passe"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Disabled="@_changingPassword" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               OnClick="ChangerMotDePasse" Disabled="@_changingPassword"
                               StartIcon="@Icons.Material.Filled.Key">
                        @(_changingPassword ? "Modification…" : "Changer le mot de passe")
                    </MudButton>
                </MudCardActions>
            </MudCard>

            <!-- Ligues gérées (commissaire uniquement) -->
            @if (_estCommissaire && _ligues?.Count > 0)
            {
                <MudCard Elevation="2" Class="mb-3">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-1" Size="Size.Small" />
                            <b>Ligues gérées</b>
                        </MudText>
                        @foreach (var ligue in _ligues)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                      Class="py-1" Style="border-bottom:1px solid rgba(255,255,255,0.06)">
                                <div>
                                    <MudText Typo="Typo.body2"><b>@ligue.Nom</b></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @ligue.Game?.Nom — @ligue.Equipes.Count équipe(s)
                                    </MudText>
                                </div>
                                <MudChip T="string" Color="@LeagueColor(ligue.Statut)" Size="Size.Small">
                                    @LeagueLabel(ligue.Statut)
                                </MudChip>
                            </MudStack>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="/ligues" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew">
                            Toutes les ligues
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            }
        </MudItem>

        <!-- Mes équipes -->
        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Group" Class="mr-1" />
                <b>Mes équipes</b>
            </MudText>
            @if (_equipes is null)
            {
                <MudProgressLinear Color="Color.Error" Indeterminate="true" />
            }
            else if (!_equipes.Any())
            {
                <MudAlert Severity="Severity.Info">
                    Aucune équipe pour le moment. Rejoignez une ligue pour en créer une.
                    <MudLink Href="/ligues" Class="ml-2">Voir les ligues</MudLink>
                </MudAlert>
            }
            else
            {
                <MudGrid>
                    @foreach (var equipe in _equipes)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="1" Style="cursor:pointer"
                                     @onclick="@(() => Nav.NavigateTo($"/equipes/{equipe.Id}"))">
                                <MudCardContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                                        <MudText Typo="Typo.h6"><b>@equipe.Nom</b></MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            @equipe.TeamType?.Nom
                                        </MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                        @(equipe.League?.Nom ?? "Hors ligue")
                                    </MudText>
                                    <MudStack Row="true" Spacing="3">
                                        <div>
                                            <MudText Typo="Typo.caption">Matchs</MudText>
                                            <MudText Typo="Typo.body2"><b>@equipe.NombreMatchsJoues</b></MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption">V/N/D</MudText>
                                            <MudText Typo="Typo.body2">
                                                <b>@equipe.NombreVictoires/@equipe.NombreNuls/@equipe.NombreDefaites</b>
                                            </MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption">Points</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Error"><b>@equipe.PointsLigue</b></MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption">Joueurs</MudText>
                                            <MudText Typo="Typo.body2">
                                                <b>@equipe.Joueurs.Count(j => !j.EstMort && !j.EstRetraite)</b>
                                            </MudText>
                                        </div>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudItem>

        <!-- Export RGPD : mes données personnelles -->
        <MudItem xs="12">
            <MudCard Elevation="2" Class="mt-3">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.FolderShared" Class="mr-1" Size="Size.Small" />
                        <b>Mes données personnelles</b>
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Vous pouvez récupérer à tout moment l'ensemble des informations
                        que l'application conserve à votre sujet : compte, équipes et leurs
                        joueurs, matchs, ligues gérées et feuilles de match saisies. Le
                        fichier est au format JSON, lisible dans n'importe quel éditeur
                        de texte.
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    @* Endpoint SSR et non bouton interactif : la réponse est un
                       fichier à télécharger, pas un rendu de page. *@
                    <form action="/Account/ExporterMesDonnees" method="post">
                        <AntiforgeryToken />
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Outlined" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.Download">
                            Télécharger mes données
                        </MudButton>
                    </form>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Abonnement calendrier : régénération du lien secret -->
        <MudItem xs="12">
            <MudCard Elevation="2" Class="mt-3">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Link" Class="mr-1" Size="Size.Small" />
                        <b>Abonnement à mon calendrier</b>
                    </MudText>

                    @if (!_aUnJeton)
                    {
                        <MudText Typo="Typo.body2">
                            Vous n'avez pas encore de lien d'abonnement. Créez-le depuis
                            <b>Mes matchs</b> ou depuis la fiche d'une ligue, avec le bouton
                            « S'abonner à mes matchs ».
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">
                            Un lien d'abonnement existe pour votre compte. Il donne accès à
                            vos matchs <b>sans mot de passe</b> : toute personne qui l'obtient
                            peut les consulter.
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-2">
                            Si vous l'avez partagé par erreur, régénérez-le : l'ancienne
                            adresse cesse aussitôt de fonctionner, et vous devrez recoller
                            la nouvelle dans votre agenda.
                        </MudText>

                        @if (_confirmerRegeneration)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                                Confirmer ? Les agendas déjà abonnés cesseront de se mettre à jour
                                tant que vous n'y aurez pas collé la nouvelle adresse.
                            </MudAlert>
                        }
                    }
                </MudCardContent>
                <MudCardActions>
                    @if (_aUnJeton && !_confirmerRegeneration)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Autorenew"
                                   OnClick="@(() => _confirmerRegeneration = true)">
                            Régénérer mon lien…
                        </MudButton>
                    }
                    else if (_aUnJeton)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Autorenew"
                                   Disabled="_regenerationEnCours"
                                   OnClick="RegenererJeton">
                            Oui, régénérer
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   OnClick="@(() => _confirmerRegeneration = false)">
                            Annuler
                        </MudButton>
                    }
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Zone de danger : suppression du compte -->
        <MudItem xs="12">
            <MudCard Elevation="2" Class="mt-3" Style="border:1px solid var(--mud-palette-error)">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle1" Color="Color.Error" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-1" Size="Size.Small" />
                        <b>Supprimer mon compte</b>
                    </MudText>

                    @if (_verdict is null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Vérification…</MudText>
                    }
                    else if (_verdict.PeutEtreSupprimeDur)
                    {
                        <MudText Typo="Typo.body2">
                            Aucune donnée de jeu n'est rattachée à votre compte :
                            il sera <b>intégralement supprimé</b>. Cette action est définitive.
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">
                            Votre compte est rattaché à <b>@ResumeImpacts()</b>. Ces éléments
                            appartiennent aussi aux autres participants : ils seront conservés.
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-2">
                            Votre e-mail, votre mot de passe et votre pseudo seront effacés,
                            et vous ne pourrez plus vous connecter. Vos équipes resteront dans
                            leurs ligues sous le nom « Coach supprimé ».
                        </MudText>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteForever"
                               Href="/compte/supprimer">
                        Supprimer mon compte…
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

    </MudGrid>
}

@code {
    ApplicationUser? _user;

    /// <summary>
    /// Un lien d'abonnement iCalendar existe-t-il ? On n'affiche jamais le
    /// jeton ici : /profil sert à l'INVALIDER, l'adresse complète se récupère
    /// depuis « Mes matchs » ou la fiche de ligue.
    /// </summary>
    bool _aUnJeton;
    bool _confirmerRegeneration;
    bool _regenerationEnCours;

    /// <summary>
    /// Remplace le secret : toute URL déjà collée dans un agenda répond
    /// aussitôt 404. Seule parade en cas de fuite, d'où la confirmation.
    /// </summary>
    async Task RegenererJeton()
    {
        if (_user is null) return;

        _regenerationEnCours = true;
        try
        {
            var jeton = await Abonnement.RegenererJetonAsync(_user.Id);
            if (jeton is null)
            {
                Snackbar.Add("Impossible de régénérer le lien.", Severity.Error);
                return;
            }

            _aUnJeton = true;
            _confirmerRegeneration = false;
            Snackbar.Add(
                "Lien régénéré. L'ancienne adresse ne fonctionne plus : recopiez la "
                + "nouvelle depuis « Mes matchs » dans votre agenda.",
                Severity.Success);
        }
        finally
        {
            _regenerationEnCours = false;
        }
    }

    /// <summary>
    /// Ce qui sera réellement effacé : affiché AVANT que le coach clique, pour
    /// qu'il sache si son compte disparaît ou s'il est seulement anonymisé.
    /// </summary>
    UserAccountService.VerdictSuppression? _verdict;

    /// <summary>Énumère en clair ce qui rattache le compte à la vie des ligues.</summary>
    string ResumeImpacts()
    {
        if (_verdict is null) return "";
        var bouts = new List<string>();
        if (_verdict.NbEquipes > 0)
            bouts.Add($"{_verdict.NbEquipes} équipe{(_verdict.NbEquipes > 1 ? "s" : "")}");
        if (_verdict.NbLigues > 0)
            bouts.Add($"{_verdict.NbLigues} ligue{(_verdict.NbLigues > 1 ? "s" : "")} que vous gérez");
        if (_verdict.NbFeuilles > 0)
            bouts.Add($"{_verdict.NbFeuilles} feuille{(_verdict.NbFeuilles > 1 ? "s" : "")} de match");
        if (_verdict.NbCommissariats > 0)
            bouts.Add($"{_verdict.NbCommissariats} commissariat{(_verdict.NbCommissariats > 1 ? "s" : "")}");

        return bouts.Count switch
        {
            0 => "aucune donnée de jeu",
            1 => bouts[0],
            _ => string.Join(", ", bouts.Take(bouts.Count - 1)) + " et " + bouts[^1]
        };
    }
    List<Team>? _equipes;
    List<League>? _ligues;
    bool _estCommissaire;

    string _pseudoEdit = "";
    bool _savingPseudo;

    string _ancienMdp = "";
    string _nouveauMdp = "";
    string _confirmMdp = "";
    bool _changingPassword;

    string _nouvelEmail = "";
    bool _changingEmail;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value;
        if (userId is null) { Nav.NavigateTo("/Account/Login"); return; }

        _user = await UserManager.FindByIdAsync(userId);
        if (_user is null) { Nav.NavigateTo("/Account/Login"); return; }

        _verdict = await UserAccountService.EvaluerSuppressionAsync(userId);

        _aUnJeton = !string.IsNullOrEmpty(_user.JetonCalendrier);

        // ⚠️ Le rôle "Commissaire" n'existe plus (DbSeeder le migre vers "Admin") :
        // ce test renvoyait toujours false et le bloc « Ligues gérées » n'était
        // jamais affiché. Ici il n'y a pas de ligue en contexte, on cumule donc
        // les rôles transverses et l'appartenance effective à une ligue.
        _pseudoEdit = _user.PseudoCoach ?? "";
        _equipes = await TeamService.GetEquipesCoachAsync(userId);

        var toutesLigues = await LeagueService.GetAllLiguesAsync();
        _ligues = toutesLigues
            .Where(l => l.CommissaireId == userId
                     || l.CommissairesDeLigue.Any(c => c.UserId == userId))
            .ToList();

        _estCommissaire = await Auth.EstAdminAsync(userId)
                       || await Auth.EstGrandCommissaireAsync(userId)
                       || _ligues.Count > 0;
    }

    async Task ChangerPseudo()
    {
        if (_user is null) return;
        _savingPseudo = true;
        try
        {
            _user.PseudoCoach = _pseudoEdit.Trim();
            var result = await UserManager.UpdateAsync(_user);
            if (result.Succeeded)
                Snackbar.Add("Pseudo mis à jour.", Severity.Success);
            else
                Snackbar.Add($"Erreur : {string.Join(", ", result.Errors.Select(e => e.Description))}", Severity.Error);
        }
        finally { _savingPseudo = false; }
    }

    async Task ChangerEmail()
    {
        if (_user is null) return;

        var nouvel = _nouvelEmail.Trim();

        if (string.IsNullOrWhiteSpace(nouvel))
        {
            Snackbar.Add("Veuillez saisir la nouvelle adresse email.", Severity.Warning);
            return;
        }
        if (string.Equals(nouvel, _user.Email, StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Cette adresse est déjà la vôtre.", Severity.Warning);
            return;
        }
        if (!new EmailAddressAttribute().IsValid(nouvel))
        {
            Snackbar.Add("Adresse email invalide.", Severity.Warning);
            return;
        }
        if (await UserManager.FindByEmailAsync(nouvel) is not null)
        {
            Snackbar.Add("Cette adresse est déjà utilisée par un autre compte.", Severity.Error);
            return;
        }

        // Sans compte Gmail configuré, l'envoi est ignoré silencieusement : on refuse
        // plutôt que d'annoncer un envoi qui n'arrivera jamais.
        if (!await EmailSender.EstConfigureAsync())
        {
            Snackbar.Add(
                "L'envoi d'emails n'est pas configuré sur ce site. Contactez un administrateur (Admin > Paramètres).",
                Severity.Error);
            return;
        }

        _changingEmail = true;
        try
        {
            var code = await UserManager.GenerateChangeEmailTokenAsync(_user, nouvel);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

            var lien = Nav.GetUriWithQueryParameters(
                Nav.ToAbsoluteUri("Account/ConfirmEmailChange").AbsoluteUri,
                new Dictionary<string, object?>
                {
                    ["userId"] = _user.Id,
                    ["email"] = nouvel,
                    ["code"] = code
                });

            await EmailSender.EnvoyerNotificationMatchAsync(
                nouvel,
                "Confirmation de votre nouvelle adresse — BolDeSang Manager",
                "Confirmer votre nouvelle adresse email",
                "Vous avez demandé à modifier l'adresse email de votre compte BolDeSang Manager. " +
                "Cliquez sur le bouton ci-dessous pour confirmer. Vous devrez ensuite vous reconnecter avec cette nouvelle adresse.",
                lien,
                "Confirmer ma nouvelle adresse",
                footer: "Si vous n'avez pas fait cette demande, ignorez cet email — votre adresse actuelle restera inchangée.");

            Snackbar.Add($"Un lien de confirmation a été envoyé à {nouvel}. Votre adresse actuelle reste active tant qu'il n'est pas validé.", Severity.Success);
            _nouvelEmail = "";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Échec de l'envoi : {ex.Message}", Severity.Error);
        }
        finally { _changingEmail = false; }
    }

    async Task ChangerMotDePasse()
    {
        if (_user is null) return;

        if (string.IsNullOrWhiteSpace(_ancienMdp) || string.IsNullOrWhiteSpace(_nouveauMdp))
        {
            Snackbar.Add("Veuillez remplir tous les champs.", Severity.Warning);
            return;
        }
        if (_nouveauMdp != _confirmMdp)
        {
            Snackbar.Add("Les mots de passe ne correspondent pas.", Severity.Warning);
            return;
        }
        if (_nouveauMdp.Length < 8)
        {
            Snackbar.Add("Le mot de passe doit contenir au moins 8 caractères.", Severity.Warning);
            return;
        }

        _changingPassword = true;
        try
        {
            var result = await UserManager.ChangePasswordAsync(_user, _ancienMdp, _nouveauMdp);
            if (result.Succeeded)
            {
                _ancienMdp = "";
                _nouveauMdp = "";
                _confirmMdp = "";
                Snackbar.Add("Mot de passe modifié avec succès.", Severity.Success);
            }
            else
            {
                var erreurs = result.Errors.Select(e => e.Description);
                Snackbar.Add($"Erreur : {string.Join(", ", erreurs)}", Severity.Error);
            }
        }
        finally { _changingPassword = false; }
    }

}
