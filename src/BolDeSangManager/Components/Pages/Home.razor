@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject LeagueService LeagueService
@inject TeamService TeamService
@inject MatchService MatchService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject BolDeSangManager.Services.IAuthorizationService Auth
@inject ISnackbar Snackbar

<PageTitle>BolDeSang Manager</PageTitle>

<!-- Bandeau Blood Bowl -->
@* Les marges négatives annulent le padding du MudContainer pour un effet
   pleine largeur. Ce padding vaut 16px à partir de sm mais seulement 8px
   sur téléphone (Class="px-2 px-sm-4" dans MainLayout) : un -16px codé en
   dur débordait donc de 8px de chaque côté (audit R9f). La variable est
   redéfinie sous 600px dans app.css. *@
<div class="home-bandeau">
    <img src="/images/bandeau.webp" alt="BolDeSang Manager" style="width:100%; display:block; object-fit:cover; object-position:center top;" />
</div>

<AuthorizeView>
    <Authorized>
        <MudGrid>
            <!-- Mes matchs -->
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            @* Le titre est lui-même le lien vers /matchs (issue #14) : l'icône
                               OpenInNew rend l'affordance visible sans survol, donc utilisable
                               au doigt sur téléphone. *@
                            <MudLink Href="/matchs" Color="Color.Inherit" Underline="Underline.None">
                                <MudText Typo="Typo.h6">
                                    <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Class="mr-2" />
                                    Mes Matchs
                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="ml-1" />
                                </MudText>
                            </MudLink>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_mesMatchs is null)
                        {
                            <MudProgressCircular Color="Color.Error" Indeterminate="true" Size="Size.Small" />
                        }
                        else if (!_mesMatchs.Any())
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Aucun match à venir.
                            </MudText>
                        }
                        else
                        {
                            <MudGrid>
                                @foreach (var match in _mesMatchs)
                                {
                                    <MudItem xs="12" sm="6" md="4">
                                        <CarteMatch Match="match"
                                                    UserId="@_userId"
                                                    EstCommissaire="@EstCommissaireDe(match)"
                                                    MesEquipes="_mesEquipeIds"
                                                    AfficherLigue="true"
                                                    Change="Recharger" />
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Ligues en cours -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
                                Ligues en cours
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                          Color="Color.Primary" Href="/ligues" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_ligues is null)
                        {
                            <MudProgressCircular Color="Color.Error" Indeterminate="true" Size="Size.Small" />
                        }
                        else if (!_ligues.Any())
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Aucune ligue en cours.
                            </MudText>
                        }
                        else
                        {
                            <MudList T="League" Dense="true">
                                @foreach (var ligue in _ligues.Take(5))
                                {
                                    <MudListItem OnClick="@(() => Nav.NavigateTo($"/ligues/{ligue.Id}"))">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <div>
                                                <MudText Typo="Typo.body1"><b>@ligue.Nom</b></MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @ligue.Game?.Nom — @ligue.RulesVersion?.Nom
                                                </MudText>
                                            </div>
                                            <MudChip T="string" Color="LeagueColor(ligue.Statut)" Size="Size.Small">
                                                @ligue.Statut.ToString()
                                            </MudChip>
                                        </MudStack>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Mes équipes -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.Group" Class="mr-2" />
                                Mes Équipes
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_mesEquipes is null)
                        {
                            <MudProgressCircular Color="Color.Error" Indeterminate="true" Size="Size.Small" />
                        }
                        else if (!_mesEquipes.Any())
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Pas encore d'équipe — rejoignez une ligue pour en créer une.
                            </MudText>
                            <MudButton Href="/ligues" Variant="Variant.Filled"
                                      Color="Color.Error" Class="mt-2" Size="Size.Small">
                                Voir les ligues
                            </MudButton>
                        }
                        else
                        {
                            <MudList T="Team" Dense="true">
                                @foreach (var equipe in _mesEquipes)
                                {
                                    <MudListItem OnClick="@(() => Nav.NavigateTo($"/equipes/{equipe.Id}"))">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <div>
                                                <MudText Typo="Typo.body1"><b>@equipe.Nom</b></MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @equipe.TeamType?.Nom — @equipe.League?.Nom
                                                </MudText>
                                            </div>
                                            <MudChip T="string" Color="Color.Error" Size="Size.Small">
                                                @equipe.Joueurs.Count(j => !j.EstMort && !j.EstRetraite) joueurs
                                            </MudChip>
                                        </MudStack>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </Authorized>
</AuthorizeView>

@code {
    List<Team>? _mesEquipes;
    List<League>? _ligues;
    List<Match>? _mesMatchs;
    HashSet<int> _mesEquipeIds = [];
    string _userId = "";

    /// <summary>Ligues que l'utilisateur peut gérer (droits réels, pas un rôle).</summary>
    HashSet<int> _liguesGerees = [];

    bool EstCommissaireDe(Match m) =>
        m.Division is not null && _liguesGerees.Contains(m.Division.LeagueId);

    async Task Recharger()
    {
        await ChargerAsync();
        StateHasChanged();
    }

    protected override Task OnInitializedAsync() => ChargerAsync();

    async Task ChargerAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _ligues = await LeagueService.GetAllLiguesAsync();

        if (user.Identity?.IsAuthenticated != true) return;

        _userId = user.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";
        var userId = _userId;
        _mesEquipes = await TeamService.GetEquipesCoachAsync(userId);

        var statuts = new[] { MatchStatus.Programme, MatchStatus.AJouer, MatchStatus.FeuilleEnSaisie, MatchStatus.ValidationCompetences };

        // Une seule requête pour toutes les équipes du coach : la boucle
        // précédente déclenchait un aller-retour SQL par équipe (N+1).
        _mesEquipeIds = _mesEquipes.Select(e => e.Id).ToHashSet();
        var tousMatchs = (await MatchService.GetMatchsEquipesAsync(_mesEquipeIds))
            .Where(m => statuts.Contains(m.Statut))
            .DistinctBy(m => m.Id)
            .ToList();

        // Mode brouillard : cet écran agrège les matchs de TOUTES les ligues du
        // coach. Sans ce filtre, le calendrier masqué sur la fiche de ligue
        // ressortait ici — le coach voyait ses rondes futures sur l'accueil.
        var brouillardParLigue = (_ligues ?? []).ToDictionary(l => l.Id, l => l.ModeBrouillard);
        var commissaireDe = (_ligues ?? [])
            .Where(l => l.CommissaireId == userId
                        || l.CommissairesDeLigue.Any(c => c.UserId == userId))
            .Select(l => l.Id)
            .ToHashSet();

        var visibles = BrouillardHelpers.FiltrerVisiblesMultiLigues(
            tousMatchs, _mesEquipeIds, brouillardParLigue, commissaireDe);

        // Droits réels ligue par ligue (Admin/GrandCommissaire gèrent tout).
        _liguesGerees = [];
        foreach (var l in _ligues ?? [])
        {
            if (await Auth.PeutGererLigueAsync(userId, l.Id))
                _liguesGerees.Add(l.Id);
        }

        _mesMatchs = SelectionnerPourAccueil(visibles, _userId, _mesEquipeIds);
    }

    /// <summary>
    /// Ce que l'accueil montre : LE prochain match de chaque ligue, plus tout
    /// match qui attend encore une action de ce coach.
    ///
    /// L'exception « en attente » n'est pas cosmétique : sans elle, une feuille
    /// à confirmer ou un après-match à remplir sur une rencontre déjà passée
    /// disparaîtrait de l'accueil, et le coach n'aurait plus aucun rappel de ce
    /// qu'on attend de lui.
    ///
    /// Fonction pure (aucun accès base) pour être testable directement.
    /// </summary>
    public static List<Match> SelectionnerPourAccueil(
        IEnumerable<Match> matchsVisibles, string userId, IReadOnlySet<int> mesEquipes) =>
        matchsVisibles
            .GroupBy(m => m.Division?.LeagueId)
            .SelectMany(groupe =>
            {
                var enAttente = groupe
                    .Where(m => DisplayHelpers.AttendUneActionDe(m, userId, mesEquipes));

                var prochain = groupe
                    .Where(m => m.Statut is MatchStatus.Programme or MatchStatus.AJouer)
                    .OrderBy(m => m.Ronde).ThenBy(m => m.Id)
                    .Take(1);

                return enAttente.Concat(prochain);
            })
            .DistinctBy(m => m.Id)
            // Les actions en attente d'abord : c'est le plus urgent pour le coach.
            .OrderByDescending(m => DisplayHelpers.AttendUneActionDe(m, userId, mesEquipes))
            .ThenBy(m => m.Division?.LeagueId)
            .ThenBy(m => m.Ronde)
            .ToList();
}
