@page "/a-propos"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS

<PageTitle>À propos — BolDeSang Manager</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudText Typo="Typo.h4" Color="Color.Error" Class="mb-4"><b>À propos</b></MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">BolDeSang Manager</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                @_version
            </MudChip>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
            Gestionnaire de ligues Blood Bowl &amp; Dungeon Bowl — projet de fan développé bénévolement.
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-1" Size="Size.Small" />
            Licence
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Ce logiciel est distribué sous licence <b>GNU Affero General Public License v3.0</b> (AGPL-3.0).
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            Cela signifie que vous pouvez librement consulter, modifier et redistribuer le code, à condition
            que toute version modifiée — y compris déployée comme service réseau — soit également publiée
            sous la même licence.
        </MudText>
        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Href="https://github.com/cottedavid38-hue/BolDeSangManager"
                       Target="_blank" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Custom.Brands.GitHub">
                Code source
            </MudButton>
            <MudButton Href="https://www.gnu.org/licenses/agpl-3.0.html"
                       Target="_blank" Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.OpenInNew">
                Texte de la licence
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Feedback" Class="mr-1" Size="Size.Small" />
            Suggestions &amp; bugs
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Une idée d'amélioration ou un bug à signaler ? Les retours sont gérés sur GitHub Issues.
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            Aucun compte ? La création d'un compte GitHub est gratuite et rapide.
        </MudText>
        <MudStack Row="true" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
            <MudButton Href="@_bugUrl"
                       Target="_blank" Variant="Variant.Filled" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.BugReport">
                Signaler un bug
            </MudButton>
            <MudButton Href="@_featureUrl"
                       Target="_blank" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Lightbulb">
                Proposer une amélioration
            </MudButton>
            <MudButton Href="https://github.com/cottedavid38-hue/BolDeSangManager/issues"
                       Target="_blank" Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.List">
                Voir toutes les issues
            </MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 d-block">
            Contexte joint automatiquement : <code>@_contexte</code>
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1" Style="border-left:3px solid #ff9800">
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-1" Size="Size.Small" />
            Avis légal — Propriété intellectuelle
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Ce projet est un outil non-officiel développé par des fans. Il n'est ni affilié à,
            ni approuvé par, ni sponsorisé par Games Workshop Ltd.
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            <b>Blood Bowl</b>, <b>Dungeon Bowl</b>, ainsi que tous les noms, races, marques,
            logos, illustrations et univers associés sont la propriété exclusive de
            <b>Games Workshop Ltd.</b>
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Seul le code source de l'application est couvert par la licence AGPL-3.0 mentionnée
            ci-dessus. Les règles et l'univers du jeu restent la propriété intellectuelle de
            leurs détenteurs respectifs.
        </MudText>
        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Href="https://www.games-workshop.com"
                       Target="_blank" Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.OpenInNew">
                games-workshop.com
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private const string IssuesBase = "https://github.com/cottedavid38-hue/BolDeSangManager/issues/new";

    private string _version = Environment.GetEnvironmentVariable("APP_VERSION") ?? "dev";
    private string _pseudo = "anonyme";
    private string _role = "anonyme";
    private string _browser = "inconnu";
    private string _contexte = "";
    private string _bugUrl = $"{IssuesBase}?template=bug.yml";
    private string _featureUrl = $"{IssuesBase}?template=feature.yml";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        if (principal.Identity?.IsAuthenticated == true)
        {
            var user = await UserManager.GetUserAsync(principal);
            if (user is not null)
                _pseudo = !string.IsNullOrWhiteSpace(user.PseudoCoach) ? user.PseudoCoach! : (user.UserName ?? "anonyme");

            foreach (var r in new[] { "Admin", "GrandCommissaire", "CommissaireDeLigue", "Coach" })
            {
                if (principal.IsInRole(r)) { _role = r; break; }
            }
        }
        BuildUrls();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _browser = await JS.InvokeAsync<string>("getBrowserInfo");
            BuildUrls();
            StateHasChanged();
        }
        catch { /* JS indispo — on garde "inconnu" */ }
    }

    private void BuildUrls()
    {
        _contexte = $"Pseudo: {_pseudo} | Rôle: {_role} | Navigateur: {_browser} | Version: {_version}";
        var encoded = Uri.EscapeDataString(_contexte);
        _bugUrl = $"{IssuesBase}?template=bug.yml&contexte={encoded}";
        _featureUrl = $"{IssuesBase}?template=feature.yml&contexte={encoded}";
    }
}
