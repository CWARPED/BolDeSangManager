@page "/ligues/{Id:int}/staff"
@rendermode InteractiveServer
@attribute [Authorize]
@inject LeagueService LeagueService
@inject StaffService StaffService
@inject BolDeSangManager.Services.IAuthorizationService Auth
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Staff de la ligue</PageTitle>

@if (_chargement)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_ligue is null)
{
    <MudAlert Severity="Severity.Error" Class="ma-4">Ligue introuvable.</MudAlert>
}
else if (!_peutGerer)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">
        Seul le commissaire de la ligue peut régler le staff.
    </MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@($"/ligues/{Id}")" />
        <MudText Typo="Typo.h5"><b>Staff & Équipement</b></MudText>
    </MudStack>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Ligue <b>@_ligue.Nom</b>. Ces réglages ne concernent que cette ligue :
        modifier ici ne touche ni les règles, ni les autres ligues.
    </MudText>

    @if (_staff.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">
            Aucun staff dans cette ligue. Ajoutez-en dans
            <b>Édition des données → Staff</b>, puis recréez une ligue.
        </MudAlert>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-4">
            <MudTable Items="@_staff" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                      Style="font-size:12px">
                <HeaderContent>
                    <MudTh>Staff</MudTh>
                    <MudTh Style="text-align:right">Coût</MudTh>
                    <MudTh Style="text-align:center">Min créa.</MudTh>
                    <MudTh Style="text-align:center">Max créa.</MudTh>
                    <MudTh Style="text-align:center">Plafond ligue</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Staff">
                        <MudCheckBox T="bool" Value="@context.EstActif" Dense="true"
                                     ValueChanged="@(v => context.EstActif = v)"
                                     Color="Color.Primary" Label="@context.Nom" />
                        @if (!string.IsNullOrWhiteSpace(context.Description))
                        {
                            @* La description passe SOUS le nom, hors de la cellule étroite :
                               en vue mobile MudBlazor empile label/valeur et la colonne
                               de droite ne fait que quelques caractères de large. *@
                            <div class="staff-desc">@context.Description</div>
                        }
                    </MudTd>
                    <MudTd DataLabel="Coût" Style="text-align:right">
                        @if (context.CoutDepuisTypeEquipe)
                        {
                            <span style="font-size:11px; color:#90caf9"
                                  title="Le prix vient de la fiche de la race (Coût relance).">
                                selon la race
                            </span>
                        }
                        else
                        {
                            <MudNumericField T="int" @bind-Value="context.Cout" Min="0" Step="5000"
                                             Variant="Variant.Text" Margin="Margin.Dense"
                                             Disabled="@(!context.EstActif)" Style="max-width:110px" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Min à la création" Style="text-align:center">
                        <MudNumericField T="int" @bind-Value="context.MinCreation" Min="0" Max="99"
                                         Variant="Variant.Text" Margin="Margin.Dense"
                                         Disabled="@(!context.EstActif)" Style="max-width:70px" />
                    </MudTd>
                    <MudTd DataLabel="Max à la création" Style="text-align:center">
                        <MudNumericField T="int" @bind-Value="context.MaxCreation" Min="0" Max="99"
                                         Variant="Variant.Text" Margin="Margin.Dense"
                                         Disabled="@(!context.EstActif)" Style="max-width:70px" />
                    </MudTd>
                    <MudTd DataLabel="Plafond en cours de ligue" Style="text-align:center">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Justify="Justify.Center">
                            <MudCheckBox T="bool" Dense="true" Color="Color.Primary"
                                         Value="@(context.MaxLigue.HasValue)"
                                         ValueChanged="@(v => BasculerPlafond(context, v))"
                                         Disabled="@(!context.EstActif)"
                                         title="Décoché = aucune limite en cours de ligue" />
                            @if (context.MaxLigue.HasValue)
                            {
                                <MudNumericField T="int" Min="0" Max="99"
                                                 Value="@context.MaxLigue.Value"
                                                 ValueChanged="@(v => context.MaxLigue = v)"
                                                 Variant="Variant.Text" Margin="Margin.Dense"
                                                 Disabled="@(!context.EstActif)" Style="max-width:70px" />
                            }
                            else
                            {
                                <span style="font-size:11px; color:#9e9e9e">illimité</span>
                            }
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 d-block">
                Le plafond de ligue est strict : il s'applique aux achats <b>comme</b> aux fans
                gagnés par les résultats de match. Abaisser un plafond bloque les futurs achats
                mais ne retire rien aux équipes qui sont déjà au-dessus.
            </MudText>

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                <MudButton Href="@($"/ligues/{Id}")" Variant="Variant.Text" Disabled="@_saving">
                    Annuler
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="Enregistrer" Disabled="@_saving">
                    @(_saving ? "Enregistrement..." : "Enregistrer")
                </MudButton>
            </MudStack>
        </MudPaper>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    League? _ligue;
    List<LeagueStaffType> _staff = [];
    bool _peutGerer, _chargement = true, _saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ligue = await LeagueService.GetLigueAsync(Id);
            if (_ligue is null) return;

            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";

            _peutGerer = await Auth.PeutGererLigueAsync(userId, Id);
            if (!_peutGerer) return;

            _staff = await StaffService.GetStaffLigueAsync(Id);
        }
        finally
        {
            _chargement = false;
        }
    }

    void BasculerPlafond(LeagueStaffType staff, bool plafonne) =>
        staff.MaxLigue = plafonne ? Math.Max(staff.MaxCreation, 1) : null;

    async Task Enregistrer()
    {
        _saving = true;
        try
        {
            foreach (var s in _staff)
                await StaffService.ModifierStaffLigueAsync(s);

            Snackbar.Add("Staff de la ligue enregistré.", Severity.Success);
            Nav.NavigateTo($"/ligues/{Id}");
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Impossible d'enregistrer le staff.", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
