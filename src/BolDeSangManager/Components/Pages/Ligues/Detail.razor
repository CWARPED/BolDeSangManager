@page "/ligues/{Id:int}"
@rendermode InteractiveServer
@inject LeagueService LeagueService
@inject TeamService TeamService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject BolDeSangManager.Services.IAuthorizationService Auth
@inject MarkdownService Markdown
@inject PdfService PdfService
@inject IJSRuntime JS
@inject CalendrierService CalendrierService

<PageTitle>@(_ligue?.Nom ?? "Ligue") — BolDeSang Manager</PageTitle>

@if (_ligue is null)
{
    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
}
else
{
    <!-- En-tête -->
    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
        <div>
            <MudText Typo="Typo.h5" Color="Color.Error"><b>@_ligue.Nom</b></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @_ligue.Game?.Nom — @_ligue.RulesVersion?.Nom
                | Commissaire : @(_ligue.Commissaire?.PseudoCoach ?? _ligue.Commissaire?.UserName)
            </MudText>
        </div>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudChip T="string" Color="@LeagueColor(_ligue.Statut)">@LeagueLabel(_ligue.Statut)</MudChip>
            @if (_estCommissaire)
            {
                @if (_ligue.Statut == LeagueStatus.Creation)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                              OnClick="OuvrirInscriptions">
                        Ouvrir les inscriptions
                    </MudButton>
                }
                @if (_ligue.Statut == LeagueStatus.Inscription && _ligue.Equipes.Count >= 2)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                              OnClick="LancerSaison">
                        Lancer la saison
                    </MudButton>
                }
                @if (DisplayHelpers.CalendrierEditable(_ligue.Statut, _ligue.Format))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                              StartIcon="@Icons.Material.Filled.EditCalendar"
                              OnClick="@(() => Nav.NavigateTo($"/ligues/{Id}/calendrier"))">
                        @(_ligue.Statut < LeagueStatus.EnCours ? "Préparer le calendrier" : "Composer le calendrier")
                    </MudButton>
                }
                @if (_ligue.Statut == LeagueStatus.EnCours && DisplayHelpers.AvecPlayoffs(_ligue.Format))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                              OnClick="LancerPlayoffs">
                        Générer les play-offs
                    </MudButton>
                }
                @if (_ligue.Statut == LeagueStatus.PlayOffs)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Default" Size="Size.Small"
                              OnClick="TerminerLigue">
                        Clôturer la ligue
                    </MudButton>
                }
                <MudTooltip Text="Les coaches ne voient que leur prochain match et les matchs déjà joués.">
                    <MudSwitch T="bool" Value="_ligue.ModeBrouillard" ValueChanged="BasculerBrouillard"
                               Color="Color.Error" Size="Size.Small" Label="Mode brouillard" />
                </MudTooltip>
            }
            @if (_ligue.Statut == LeagueStatus.Inscription)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                          Href="@($"/equipes/rejoindre?ligueId={_ligue.Id}")">
                    @(_estInscrit ? "Inscrire une autre équipe" : "Rejoindre la ligue")
                </MudButton>
            }
        </MudStack>
    </MudStack>

    @if (_ligue is not null)
    {
        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">Commissaires de ligue</MudText>
                @if (_peutGererLigue)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="OuvrirModalePromotion">
                        Promouvoir un coach
                    </MudButton>
                }
            </MudStack>
            @if (_commissaires.Any())
            {
                <MudList T="LeagueCommissioner" Dense="true" Class="mt-2">
                    @foreach (var c in _commissaires)
                    {
                        <MudListItem T="LeagueCommissioner" Value="@c">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Small" />
                                <MudText Typo="Typo.body2">@(c.User?.PseudoCoach ?? c.User?.Email ?? "—")</MudText>
                                @if (_peutGererLigue)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => RetirerCommissaireAsync(c.UserId))" />
                                }
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mt-2">Aucun commissaire de ligue pour l'instant.</MudText>
            }
        </MudPaper>
    }

    <MudTabs Elevation="1" Rounded="true" Class="tabs-compact" PanelClass="pt-4">
        <!-- Classement -->
        <MudTabPanel Text="Classement" Icon="@Icons.Material.Filled.Leaderboard">
            @foreach (var division in _ligue.Divisions.OrderBy(d => d.Ordre))
            {
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@division.Nom</b></MudText>
                <MudTable Items="@GetEquipesSorted(division)"
                          Dense="true" Hover="true" Elevation="0" Class="mb-4">
                    <HeaderContent>
                        <MudTh>Équipe</MudTh>
                        <MudTh>Coach</MudTh>
                        <MudTh>Race/Collège</MudTh>
                        <MudTh Style="text-align:center">J</MudTh>
                        <MudTh Style="text-align:center">V</MudTh>
                        <MudTh Style="text-align:center">N</MudTh>
                        <MudTh Style="text-align:center">D</MudTh>
                        <MudTh Style="text-align:center">TDs +</MudTh>
                        <MudTh Style="text-align:center">TDs -</MudTh>
                        <MudTh Style="text-align:center">Pts</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="equipe">
                        <MudTd DataLabel="Équipe">
                            <MudLink Href="@($"/equipes/{equipe.Id}")">@equipe.Nom</MudLink>
                        </MudTd>
                        <MudTd DataLabel="Coach">@(equipe.Coach?.PseudoCoach ?? equipe.Coach?.UserName)</MudTd>
                        <MudTd DataLabel="Race/Collège">@equipe.TeamType?.Nom</MudTd>
                        <MudTd DataLabel="Joués" Style="text-align:center">@equipe.NombreMatchsJoues</MudTd>
                        <MudTd DataLabel="Victoires" Style="text-align:center">@equipe.NombreVictoires</MudTd>
                        <MudTd DataLabel="Nuls" Style="text-align:center">@equipe.NombreNuls</MudTd>
                        <MudTd DataLabel="Défaites" Style="text-align:center">@equipe.NombreDefaites</MudTd>
                        <MudTd DataLabel="TDs marqués" Style="text-align:center" Class="mud-success-text">@equipe.TouchdownsMarques</MudTd>
                        <MudTd DataLabel="TDs encaissés" Style="text-align:center" Class="mud-error-text">@equipe.TouchdownsConcedes</MudTd>
                        <MudTd DataLabel="Points" Style="text-align:center"><b>@equipe.PointsLigue</b></MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <!-- Pool de matchs -->
        <MudTabPanel Text="Matchs" Icon="@Icons.Material.Filled.SportsSoccer">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @NbAvecDate() match(s) sur @NbMatchsVisibles() ont une date fixée
                </MudText>
                @if (NbAvecDate() > 0)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.CalendarMonth"
                               OnClick="TelechargerCalendrierLigue">
                        Calendrier (.ics)
                    </MudButton>
                }
            </MudStack>
            @if (_ligue.ModeBrouillard && !_estCommissaire)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    <b>Mode brouillard</b> — vous ne voyez que votre prochain match et les
                    rencontres déjà jouées. Le reste du calendrier apparaîtra au fur et à mesure.
                </MudAlert>
            }
            @foreach (var division in _ligue.Divisions.OrderBy(d => d.Ordre))
            {
                <MudText Typo="Typo.subtitle1" Class="mb-3"><b>@division.Nom</b></MudText>

                @foreach (var ronde in MatchsVisibles(division).GroupBy(m => m.Ronde).OrderBy(g => g.Key))
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">
                        @(ronde.Key >= 100 ? $"Play-off — Tour {ronde.Key - 99}" : $"Ronde {ronde.Key}")
                    </MudText>
                    <MudGrid Class="mb-4">
                        @foreach (var match in ronde)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudCard Outlined="true" Style="@($"{MatchBorderStyle(match.Statut)}cursor:pointer")"
                                         @onclick="@(() => Nav.NavigateTo($"/matchs/{match.Id}/detail"))">
                                    <MudCardContent Class="py-2">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                            <MudText Typo="Typo.body2" Align="Align.Center">
                                                <b>@match.EquipeDomicile?.Nom</b>
                                            </MudText>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                @if (match.Statut == MatchStatus.Termine || match.ScoreDomicile.HasValue)
                                                {
                                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">
                                                        @match.ScoreDomicile
                                                    </MudChip>
                                                    <MudText>–</MudText>
                                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">
                                                        @match.ScoreExterieur
                                                    </MudChip>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">vs</MudText>
                                                }
                                            </MudStack>
                                            <MudText Typo="Typo.body2" Align="Align.Center">
                                                <b>@match.EquipeExterieur?.Nom</b>
                                            </MudText>
                                            <MudChip T="string" Color="@MatchColor(match.Statut)"
                                                    Size="Size.Small">
                                                @MatchLabel(match.Statut)
                                            </MudChip>
                                            @if (match.DateProgrammee.HasValue)
                                            {
                                                <MudText Typo="Typo.caption" Align="Align.Center">
                                                    @DateLocale(match.DateProgrammee.Value)
                                                </MudText>
                                                @if (!string.IsNullOrWhiteSpace(match.Lieu))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
                                                        @match.Lieu
                                                    </MudText>
                                                }
                                            }
                                            else if (match.Statut is MatchStatus.Programme or MatchStatus.AJouer)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Warning" Align="Align.Center">
                                                    Date à convenir
                                                </MudText>
                                            }
                                            @if (match.Statut == MatchStatus.Programme || match.Statut == MatchStatus.AJouer || match.Statut == MatchStatus.FeuilleEnSaisie)
                                            {
                                                @if (PeutProgrammer(match))
                                                {
                                                    <div @onclick:stopPropagation="true">
                                                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                                                  StartIcon="@Icons.Material.Filled.EditCalendar"
                                                                  OnClick="@(() => Programmer(match))">
                                                            @(match.DateProgrammee.HasValue ? "Modifier la date" : "Fixer la date")
                                                        </MudButton>
                                                    </div>
                                                }
                                                @if (match.DateProgrammee.HasValue)
                                                {
                                                    <div @onclick:stopPropagation="true">
                                                        <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small"
                                                                       title="Ajouter à mon agenda (.ics)"
                                                                       OnClick="@(() => TelechargerIcsMatch(match))" />
                                                    </div>
                                                }
                                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                                          Color="Color.Error"
                                                          Href="@($"/matchs/{match.Id}/feuille")"
                                                          @onclick:stopPropagation="true">
                                                    Saisir la feuille
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
            }
        </MudTabPanel>

        <!-- Équipes inscrites -->
        <MudTabPanel Text="@($"Équipes ({_ligue.Equipes.Count})")" Icon="@Icons.Material.Filled.Group">
            <MudGrid>
                @foreach (var equipe in _ligue.Equipes)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="1" Style="cursor:pointer"
                                @onclick="@(() => Nav.NavigateTo($"/equipes/{equipe.Id}"))">
                            <MudCardContent>
                                <MudText Typo="Typo.h6"><b>@equipe.Nom</b></MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @(equipe.Coach?.PseudoCoach ?? equipe.Coach?.UserName)
                                </MudText>
                                <MudText Typo="Typo.body2">@equipe.TeamType?.Nom</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

        <!-- Calendrier mensuel (#1) -->
        <MudTabPanel Text="Calendrier" Icon="@Icons.Material.Filled.CalendarMonth">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                   title="Mois précédent" OnClick="@(() => ChangerMois(-1))" />
                    <MudText Typo="Typo.subtitle1" Style="min-width:190px;text-align:center">
                        <b>@MoisAffiche()</b>
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                   title="Mois suivant" OnClick="@(() => ChangerMois(1))" />
                    @if (_moisCourant != PremierDuMois(DateTime.Today))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RevenirAujourdhui">
                            Aujourd'hui
                        </MudButton>
                    }
                </MudStack>
                @if (NbAvecDate() > 0)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.CalendarMonth"
                               OnClick="TelechargerCalendrierLigue">
                        Calendrier (.ics)
                    </MudButton>
                }
            </MudStack>

            @if (_ligue.ModeBrouillard && !_estCommissaire)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Mode brouillard : vous ne voyez que vos matchs joués et votre prochaine rencontre.
                </MudAlert>
            }

            @{
                var matchsDuMois = MatchsDuMois();
            }
            @if (matchsDuMois.Count == 0)
            {
                <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3">
                    Aucun match programmé en @MoisAffiche().
                </MudAlert>
            }

            <!-- grille du mois -->
            <div class="calendrier-grille">
                @foreach (var jour in new[] { "lun", "mar", "mer", "jeu", "ven", "sam", "dim" })
                {
                    <div class="calendrier-entete">@jour</div>
                }
                @foreach (var jour in JoursAffiches())
                {
                    var duJour = matchsDuMois.Where(m => DateLocaleDe(m).Date == jour.Date).ToList();
                    var horsMois = jour.Month != _moisCourant.Month;
                    var rondesDuJour = _echeances.Where(e => e.Value.Date == jour.Date)
                                                 .Select(e => e.Key).OrderBy(r => r).ToList();
                    <div class="calendrier-case @(horsMois ? "hors-mois" : "") @(jour.Date == DateTime.Today ? "aujourdhui" : "")">
                        <div class="calendrier-numero">@jour.Day</div>
                        @foreach (var r in rondesDuJour)
                        {
                            <div class="calendrier-echeance"
                                 title="@($"Fin de la ronde {r} : les matchs devraient être joués avant cette date (indicatif)")">
                                Fin ronde @r
                            </div>
                        }
                        @foreach (var m in duJour)
                        {
                            <div class="calendrier-match" @onclick="@(() => Nav.NavigateTo($"/matchs/{m.Id}/detail"))"
                                 title="@($"{m.EquipeDomicile?.Nom} vs {m.EquipeExterieur?.Nom}{(string.IsNullOrWhiteSpace(m.Lieu) ? "" : $" — {m.Lieu}")}")">
                                <b>@DateLocaleDe(m).ToString("HH'h'mm")</b>
                                @($"{Abrege(m.EquipeDomicile?.Nom)} – {Abrege(m.EquipeExterieur?.Nom)}")
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- détail sous la grille : lisible sur mobile -->
            @{
                var echeancesDuMois = _echeances
                    .Where(e => e.Value.Month == _moisCourant.Month && e.Value.Year == _moisCourant.Year)
                    .OrderBy(e => e.Value).ToList();
            }
            @if (echeancesDuMois.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2"><b>Fins de ronde du mois</b></MudText>
                <MudSimpleTable Dense="true" Hover="true" Striped="true">
                    <tbody>
                        @foreach (var e in echeancesDuMois)
                        {
                            var passee = e.Value.Date < DateTime.Today;
                            <tr>
                                <td style="white-space:nowrap">
                                    <b>@e.Value.ToString("ddd d MMM")</b>
                                </td>
                                <td>
                                    Fin de la <b>ronde @e.Key</b>
                                    <br />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Date indicative — rien n'est bloqué à l'échéance.
                                    </MudText>
                                </td>
                                <td style="white-space:nowrap">
                                    @if (passee)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Échue</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">À venir</MudChip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (matchsDuMois.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2"><b>Détail du mois</b></MudText>
                <MudSimpleTable Dense="true" Hover="true" Striped="true">
                    <tbody>
                        @foreach (var m in matchsDuMois.OrderBy(DateLocaleDe))
                        {
                            <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/matchs/{m.Id}/detail"))">
                                <td style="white-space:nowrap">
                                    <b>@DateLocaleDe(m).ToString("ddd d MMM")</b><br />
                                    <span style="color:#9e9e9e">@DateLocaleDe(m).ToString("HH'h'mm")</span>
                                </td>
                                <td>
                                    @m.EquipeDomicile?.Nom <span style="color:#9e9e9e">vs</span> @m.EquipeExterieur?.Nom
                                    @if (!string.IsNullOrWhiteSpace(m.Lieu))
                                    {
                                        <br />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@m.Lieu</MudText>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    <MudChip T="string" Size="Size.Small" Color="@MatchColor(m.Statut)">
                                        @MatchLabel(m.Statut)
                                    </MudChip>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (NbSansDate() > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">
                    @NbSansDate() match(s) de la ligue n'ont pas encore de date fixée.
                </MudAlert>
            }
        </MudTabPanel>

        <!-- Règlement de la ligue (R5) -->
        <MudTabPanel Text="Règlement" Icon="@Icons.Material.Filled.Gavel">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.subtitle1"><b>Règlement</b></MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               OnClick="ExporterReglementPdf"
                               Disabled="@(_exportReglement || string.IsNullOrWhiteSpace(_ligue.Reglement))">
                        @(_exportReglement ? "Génération…" : "Exporter en PDF")
                    </MudButton>
                    @if (_estCommissaire)
                    {
                        @if (!_editionReglement)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="DemarrerEditionReglement">Modifier</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       OnClick="@(() => _editionReglement = false)">Annuler</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="EnregistrerReglement"
                                       Disabled="@_sauvegardeReglement">
                                @(_sauvegardeReglement ? "Enregistrement…" : "Sauvegarder")
                            </MudButton>
                        }
                    }
                </MudStack>
            </MudStack>

            @if (_editionReglement)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Mise en forme <b>markdown</b> : <code># Titre</code>, <code>## Sous-titre</code>,
                    <code>- liste</code>, <code>**gras**</code>, <code>*italique*</code>,
                    <code>&gt; citation</code>, <code>---</code> pour un séparateur.
                </MudAlert>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_reglementBrouillon" Label="Règlement (markdown)"
                                      Variant="Variant.Outlined" Lines="22" AutoGrow="false"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-4" Style="min-height:520px">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">Aperçu</MudText>
                            <div class="reglement-rendu">
                                @((MarkupString)Markdown.VersHtml(_reglementBrouillon))
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
            else if (string.IsNullOrWhiteSpace(_ligue.Reglement))
            {
                <MudAlert Severity="Severity.Normal" Dense="true">
                    Aucun règlement n'a encore été rédigé pour cette ligue.
                    @if (_estCommissaire)
                    {
                        <text> Cliquez sur « Modifier » pour le rédiger.</text>
                    }
                </MudAlert>
            }
            else
            {
                <MudPaper Outlined="true" Class="pa-4">
                    <div class="reglement-rendu">
                        @((MarkupString)Markdown.VersHtml(_ligue.Reglement))
                    </div>
                </MudPaper>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public int Id { get; set; }

    League? _ligue;
    // true si l'utilisateur peut gérer la ligue (Admin, GrandCommissaire ou CommissaireDeLigue)
    bool _estCommissaire;
    bool _estInscrit;
    List<LeagueCommissioner> _commissaires = [];
    bool _peutGererLigue;
    string _currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        _ligue = await LeagueService.GetLigueAsync(Id);

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value ?? "";

        _estCommissaire = _ligue is not null && await Auth.PeutGererLigueAsync(_currentUserId, _ligue.Id);
        _estInscrit = _ligue?.Equipes.Any(e => e.CoachId == _currentUserId) ?? false;

        // Échéances indicatives de fin de ronde (format Libre), affichées dans
        // le calendrier de la ligue. Ce sont des DATES (stockées à midi UTC) :
        // aucune conversion de fuseau, sinon la date affichée dériverait d'un jour.
        if (_ligue is not null)
            _echeances = (await LeagueService.GetEcheancesRondesAsync(_ligue.Id))
                .ToDictionary(e => e.Key, e => e.Value.Date);

        await ChargerCommissairesAsync();
    }

    async Task ChargerCommissairesAsync()
    {
        if (_ligue is null) return;
        _commissaires = await LeagueService.GetCommissairesDeLigueAsync(_ligue.Id);
        _peutGererLigue = await Auth.PeutGererLigueAsync(_currentUserId, _ligue.Id);
    }

    async Task OuvrirModalePromotion()
    {
        if (_ligue is null) return;
        var coaches = GetCoachesDisponibles();
        var parameters = new DialogParameters<PromotionDialog>
        {
            { x => x.LigueId, _ligue.Id },
            { x => x.Coaches, coaches },
        };
        var dialog = await DialogService.ShowAsync<PromotionDialog>("Promouvoir un coach", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await ChargerCommissairesAsync();
    }

    List<ApplicationUser> GetCoachesDisponibles()
    {
        if (_ligue is null) return [];
        var dejaPromus = _commissaires.Select(c => c.UserId).ToHashSet();
        var coachesDeLigue = _ligue.Divisions
            .SelectMany(d => d.Equipes)
            .Select(e => e.Coach)
            .Where(c => c is not null)
            .Distinct()
            .Cast<ApplicationUser>()
            .ToList();
        return coachesDeLigue.Where(c => !dejaPromus.Contains(c.Id)).ToList();
    }

    async Task RetirerCommissaireAsync(string userId)
    {
        if (_ligue is null) return;
        await LeagueService.RetirerCommissaireDeLigueAsync(_ligue.Id, userId);
        await ChargerCommissairesAsync();
        Snackbar.Add("Commissaire retiré", Severity.Success);
    }

    async Task OuvrirInscriptions()
    {
        await LeagueService.DemarrerInscriptionsAsync(Id);
        Snackbar.Add("Inscriptions ouvertes !", Severity.Success);
        _ligue = await LeagueService.GetLigueAsync(Id);
    }

    async Task LancerSaison()
    {
        try
        {
            var orphelines = await LeagueService.LancerSaisonAsync(Id);
            _ligue = await LeagueService.GetLigueAsync(Id);
            Snackbar.Add(
                _ligue is not null && DisplayHelpers.EstFormatLibre(_ligue.Format)
                    ? "Saison lancée ! Composez maintenant le calendrier."
                    : "Saison lancée ! Pool de matchs généré.",
                Severity.Success);

            // Les dates préparées avant le lancement peuvent viser des rondes que
            // le calendrier final ne contient pas : on le dit plutôt que de les
            // faire disparaître en silence.
            if (orphelines.Count > 0)
            {
                Snackbar.Add(
                    $"Échéance(s) retirée(s) : la ronde {string.Join(", ", orphelines)} n'existe pas dans le calendrier généré.",
                    Severity.Warning);
            }

            _echeances = (await LeagueService.GetEcheancesRondesAsync(Id))
                .ToDictionary(e => e.Key, e => e.Value);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task LancerPlayoffs()
    {
        try
        {
            await LeagueService.GenererPlayoffsAsync(Id);
            Snackbar.Add("Play-offs générés !", Severity.Success);
            _ligue = await LeagueService.GetLigueAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task TerminerLigue()
    {
        try
        {
            await LeagueService.TerminerLigueAsync(Id);
            Snackbar.Add("Ligue clôturée !", Severity.Success);
            _ligue = await LeagueService.GetLigueAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    static IEnumerable<Team> GetEquipesSorted(Division d) =>
        d.Equipes.OrderByDescending(e => e.PointsLigue)
                 .ThenByDescending(e => e.TouchdownsMarques - e.TouchdownsConcedes);

    // ── Calendrier (#1) ───────────────────────────────────────────────────────

    /// <summary>Date UTC stockée → affichage en heure locale du lecteur.</summary>
    static string DateLocale(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime()
            .ToString("ddd d MMM 'à' HH'h'mm");

    int NbMatchsVisibles() =>
        _ligue?.Divisions.SelectMany(d => MatchsVisibles(d)).Count() ?? 0;

    /// <summary>
    /// Qui peut fixer la date d'un match (#1) : ses deux coaches et les
    /// commissaires. Le service revérifie de toute façon côté serveur.
    /// </summary>
    bool PeutProgrammer(Match match) =>
        _estCommissaire
        || match.EquipeDomicile?.CoachId == _currentUserId
        || match.EquipeExterieur?.CoachId == _currentUserId;

    async Task Programmer(Match match)
    {
        var parametres = new DialogParameters<BolDeSangManager.Components.Pages.Matchs.ProgrammationDialog>
        {
            { x => x.Match, match },
            { x => x.UserId, _currentUserId },
            { x => x.EstCommissaire, _estCommissaire },
        };
        var dialog = await DialogService.ShowAsync<BolDeSangManager.Components.Pages.Matchs.ProgrammationDialog>(
            "Date et lieu du match", parametres,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

        if (await dialog.Result is { Canceled: false }) StateHasChanged();
    }

    async Task TelechargerIcsMatch(Match match)
    {
        var bytes = CalendrierService.GenererIcs(match);
        await JS.InvokeVoidAsync("blazorDownloadBase64File",
            $"match-{match.Id}.ics", "text/calendar", Convert.ToBase64String(bytes));
    }

    int NbAvecDate() =>
        _ligue?.Divisions.SelectMany(d => MatchsVisibles(d)).Count(m => m.DateProgrammee.HasValue) ?? 0;

    async Task TelechargerCalendrierLigue()
    {
        if (_ligue is null) return;
        // on n'exporte que ce que l'utilisateur a le droit de voir (mode brouillard)
        var matchs = _ligue.Divisions.SelectMany(d => MatchsVisibles(d)).ToList();
        var bytes = CalendrierService.GenererIcs(matchs, $"{_ligue.Nom} — BolDeSang");
        await JS.InvokeVoidAsync("blazorDownloadBase64File",
            $"calendrier-{_ligue.Nom.ToLower().Replace(" ", "-")}.ics",
            "text/calendar", Convert.ToBase64String(bytes));
    }

    // ── Vue calendrier mensuelle (#1) ─────────────────────────────────────────

    DateTime _moisCourant = PremierDuMois(DateTime.Today);

    /// <summary>Échéances indicatives de fin de ronde, par numéro de ronde (heure locale).</summary>
    Dictionary<int, DateTime> _echeances = [];

    static DateTime PremierDuMois(DateTime d) => new(d.Year, d.Month, 1);

    void ChangerMois(int delta) => _moisCourant = _moisCourant.AddMonths(delta);
    void RevenirAujourdhui() => _moisCourant = PremierDuMois(DateTime.Today);

    string MoisAffiche()
    {
        var s = _moisCourant.ToString("MMMM yyyy");
        return char.ToUpper(s[0]) + s[1..];
    }

    /// <summary>Date du match convertie en heure locale (stockage UTC).</summary>
    static DateTime DateLocaleDe(Match m) =>
        DateTime.SpecifyKind(m.DateProgrammee!.Value, DateTimeKind.Utc).ToLocalTime();

    /// <summary>
    /// Matchs datés du mois affiché, filtrés par le mode brouillard (#2) :
    /// le calendrier ne doit pas révéler ce que l'onglet Matchs masque.
    /// </summary>
    List<Match> MatchsDuMois() =>
        _ligue is null ? []
        : _ligue.Divisions.SelectMany(d => MatchsVisibles(d))
            .Where(m => m.DateProgrammee.HasValue)
            .Where(m => DateLocaleDe(m).Year == _moisCourant.Year
                     && DateLocaleDe(m).Month == _moisCourant.Month)
            .ToList();

    int NbSansDate() =>
        _ligue?.Divisions.SelectMany(d => MatchsVisibles(d))
            .Count(m => !m.DateProgrammee.HasValue
                     && m.Statut is MatchStatus.Programme or MatchStatus.AJouer) ?? 0;

    /// <summary>
    /// Les 42 cases de la grille (6 semaines) : le mois affiché, complété par
    /// les jours débordant du mois précédent et du suivant pour que chaque
    /// ligne fasse une semaine pleine, lundi en premier.
    /// </summary>
    List<DateTime> JoursAffiches()
    {
        // DayOfWeek met dimanche à 0 ; on décale pour commencer le lundi
        var decalage = ((int)_moisCourant.DayOfWeek + 6) % 7;
        var debut = _moisCourant.AddDays(-decalage);
        return Enumerable.Range(0, 42).Select(i => debut.AddDays(i)).ToList();
    }

    /// <summary>Nom d'équipe raccourci pour tenir dans une case du calendrier.</summary>
    static string Abrege(string? nom)
    {
        if (string.IsNullOrWhiteSpace(nom)) return "?";
        return nom.Length <= 12 ? nom : nom[..11] + "…";
    }

    // ── Règlement de la ligue (R5) ────────────────────────────────────────────

    bool _editionReglement;
    bool _sauvegardeReglement;
    bool _exportReglement;
    string _reglementBrouillon = "";

    void DemarrerEditionReglement()
    {
        _reglementBrouillon = _ligue?.Reglement ?? "";
        _editionReglement = true;
    }

    async Task EnregistrerReglement()
    {
        if (_ligue is null || !_estCommissaire) return;
        _sauvegardeReglement = true;
        try
        {
            await LeagueService.DefinirReglementAsync(_ligue.Id, _reglementBrouillon, _currentUserId);
            _ligue.Reglement = _reglementBrouillon;
            _editionReglement = false;
            Snackbar.Add("Règlement enregistré.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
        finally { _sauvegardeReglement = false; }
    }

    async Task ExporterReglementPdf()
    {
        if (_ligue is null) return;
        _exportReglement = true;
        try
        {
            var bytes = PdfService.GenererReglement(_ligue);
            var nom = $"reglement-{_ligue.Nom.ToLower().Replace(" ", "-")}.pdf";
            await JS.InvokeVoidAsync("blazorDownloadBase64File", nom, "application/pdf",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur PDF : {ex.Message}", Severity.Error);
        }
        finally { _exportReglement = false; }
    }

    /// <summary>Active/désactive le mode brouillard sur une ligue existante (#2).</summary>
    async Task BasculerBrouillard(bool actif)
    {
        if (_ligue is null || !_estCommissaire) return;
        try
        {
            await LeagueService.DefinirModeBrouillardAsync(_ligue.Id, actif, _currentUserId);
            _ligue.ModeBrouillard = actif;
            Snackbar.Add(actif
                ? "Mode brouillard activé : les coaches ne voient que leur prochain match."
                : "Mode brouillard désactivé : tout le calendrier est visible.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Matchs de la division visibles par l'utilisateur courant (#2 mode brouillard).
    /// Hors brouillard — ou pour un commissaire — la liste complète est renvoyée.
    /// </summary>
    IEnumerable<Match> MatchsVisibles(Division division)
    {
        if (_ligue is null) return division.Matchs;

        var mesEquipes = _ligue.Equipes
            .Where(e => e.CoachId == _currentUserId)
            .Select(e => e.Id)
            .ToHashSet();

        return BrouillardHelpers.FiltrerVisibles(
            division.Matchs, mesEquipes, _ligue.ModeBrouillard, _estCommissaire);
    }
}
