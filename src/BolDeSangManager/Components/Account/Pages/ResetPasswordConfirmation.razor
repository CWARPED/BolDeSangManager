@page "/Account/ResetPasswordConfirmation"

<PageTitle>Mot de passe modifié — BolDeSang Manager</PageTitle>

<div class="account-page-wrap">
    <MudCard Elevation="6" Style="width:100%;max-width:440px">
        <MudCardContent Class="pa-8">

            <div class="d-flex flex-column align-center mb-6">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Style="font-size:3.5rem;color:#4caf50" Class="mb-2" />
                <MudText Typo="Typo.h5" Align="Align.Center"><b>Mot de passe modifié !</b></MudText>
            </div>

            <MudAlert Severity="Severity.Success" Class="mb-4">
                Votre mot de passe a été réinitialisé avec succès.
            </MudAlert>

            <MudButton Href="Account/Login"
                       Variant="Variant.Filled"
                       Color="Color.Error"
                       FullWidth="true"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Login">
                Se connecter
            </MudButton>

        </MudCardContent>
    </MudCard>
</div>
