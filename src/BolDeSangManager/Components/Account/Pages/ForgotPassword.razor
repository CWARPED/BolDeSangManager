@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BolDeSangManager.Data

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Mot de passe oublié — BolDeSang Manager</PageTitle>

<div class="account-page-wrap">
    <MudCard Elevation="6" Style="width:100%;max-width:440px">
        <MudCardContent Class="pa-8">

            <div class="d-flex flex-column align-center mb-6">
                <MudIcon Icon="@Icons.Material.Filled.LockReset"
                         Style="font-size:3.5rem;color:var(--mud-palette-primary)" Class="mb-2" />
                <MudText Typo="Typo.h5" Align="Align.Center"><b>Mot de passe oublié ?</b></MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Entrez votre email pour recevoir un lien de réinitialisation
                </MudText>
            </div>

            <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />

                <div class="account-field">
                    <label class="account-label" for="Input.Email">Email</label>
                    <InputText id="Input.Email" @bind-Value="Input.Email"
                               class="account-input"
                               autocomplete="username"
                               placeholder="coach@exemple.com"
                               aria-required="true" />
                    <ValidationMessage For="() => Input.Email" class="account-validation-msg" />
                </div>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Error"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="mb-4"
                           StartIcon="@Icons.Material.Filled.Send">
                    Envoyer le lien
                </MudButton>
            </EditForm>

            <hr class="account-divider" />

            <div class="d-flex justify-center">
                <MudLink Href="Account/Login" Color="Color.Secondary" Typo="Typo.body2">
                    ← Retour à la connexion
                </MudLink>
            </div>

        </MudCardContent>
    </MudCard>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);

        // Ne pas révéler si l'email existe ou non — rediriger dans tous les cas
        if (user is not null)
        {
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?>
                {
                    ["code"]  = code,
                    ["email"] = Input.Email
                });

            await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));
        }

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "L'email est requis.")]
        [EmailAddress(ErrorMessage = "Format d'email invalide.")]
        public string Email { get; set; } = "";
    }
}
