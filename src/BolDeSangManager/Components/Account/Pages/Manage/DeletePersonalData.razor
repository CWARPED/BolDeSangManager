@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using BolDeSangManager.Data
@using BolDeSangManager.Services

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject UserAccountService UserAccountService
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Supprimer mon compte</PageTitle>

<StatusMessage Message="@message" />

<h3>Supprimer mon compte</h3>

@if (verdict is not null)
{
    @if (verdict.PeutEtreSupprimeDur)
    {
        <div class="alert alert-warning" role="alert">
            <p>
                <strong>Votre compte sera intégralement supprimé.</strong>
            </p>
            <p class="mb-0">
                Aucune donnée de jeu n'est rattachée à votre compte : il ne restera
                rien. Cette action est définitive.
            </p>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <p>
                <strong>Vos données personnelles seront effacées, vos résultats sportifs resteront.</strong>
            </p>
            <p>
                Votre compte est rattaché à @DescriptionImpacts(). Ces éléments
                appartiennent aussi aux autres participants : les effacer viderait
                leurs classements et leurs feuilles de match.
            </p>
            <p class="mb-0">
                Votre adresse e-mail, votre mot de passe et votre pseudo seront donc
                effacés, et vous ne pourrez plus vous connecter. Vos équipes resteront
                dans leurs ligues, sous le nom « Coach supprimé ».
            </p>
        </div>
    }

    <p>
        Avant de continuer, vous pouvez
        <a href="Account/Manage/PersonalData">télécharger une copie de vos données</a>.
    </p>
}

<div>
    <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        @if (requirePassword)
        {
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password"
                           class="form-control" autocomplete="current-password"
                           aria-required="true" placeholder="Votre mot de passe" />
                <label for="Input.Password" class="form-label">Mot de passe</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
        }

        <div class="form-floating mb-3">
            <InputText @bind-Value="Input.Confirmation" id="Input.Confirmation"
                       class="form-control" autocomplete="off"
                       aria-required="true" placeholder="SUPPRIMER" />
            <label for="Input.Confirmation" class="form-label">
                Tapez SUPPRIMER pour confirmer
            </label>
            <ValidationMessage For="() => Input.Confirmation" class="text-danger" />
        </div>

        <button class="w-100 btn btn-lg btn-danger" type="submit">
            Supprimer mon compte
        </button>
    </EditForm>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool requirePassword;
    private UserAccountService.VerdictSuppression? verdict;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        requirePassword = await UserManager.HasPasswordAsync(user);

        // Le verdict est affiché AVANT la confirmation : le coach doit savoir ce
        // qui sera réellement effacé, plutôt que de le découvrir après coup.
        verdict = await UserAccountService.EvaluerSuppressionAsync(user.Id);
    }

    /// <summary>Énumère en clair ce qui rattache le compte à la vie de la ligue.</summary>
    private string DescriptionImpacts()
    {
        if (verdict is null) return "";

        var morceaux = new List<string>();
        if (verdict.NbEquipes > 0)
            morceaux.Add($"{verdict.NbEquipes} équipe{(verdict.NbEquipes > 1 ? "s" : "")}");
        if (verdict.NbLigues > 0)
            morceaux.Add($"{verdict.NbLigues} ligue{(verdict.NbLigues > 1 ? "s" : "")} que vous gérez");
        if (verdict.NbFeuilles > 0)
            morceaux.Add($"{verdict.NbFeuilles} feuille{(verdict.NbFeuilles > 1 ? "s" : "")} de match");
        if (verdict.NbCommissariats > 0)
            morceaux.Add($"{verdict.NbCommissariats} commissariat{(verdict.NbCommissariats > 1 ? "s" : "")} de ligue");

        return morceaux.Count switch
        {
            0 => "aucune donnée de jeu",
            1 => morceaux[0],
            _ => string.Join(", ", morceaux.Take(morceaux.Count - 1)) + " et " + morceaux[^1]
        };
    }

    private async Task OnValidSubmitAsync()
    {
        if (requirePassword && !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            message = "Erreur : mot de passe incorrect.";
            return;
        }

        if (!string.Equals(Input.Confirmation?.Trim(), "SUPPRIMER", StringComparison.Ordinal))
        {
            message = "Erreur : tapez SUPPRIMER en majuscules pour confirmer.";
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);

        // Passe par le service : il choisit entre suppression réelle et
        // anonymisation. L'appel direct à UserManager.DeleteAsync échouerait
        // pour tout coach ayant déjà une équipe ou une feuille de match.
        var result = await UserAccountService.SupprimerCompteAsync(userId, parQui: "self");
        if (!result.Succeeded)
        {
            message = "Erreur : " + string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await SignInManager.SignOutAsync();
        Logger.LogInformation("Le compte {UserId} a demandé sa propre suppression.", userId);

        RedirectManager.RedirectTo("/");
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Tapez SUPPRIMER pour confirmer.")]
        public string Confirmation { get; set; } = "";
    }
}
