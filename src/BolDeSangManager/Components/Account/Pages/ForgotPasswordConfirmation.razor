@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Email envoyé — BolDeSang Manager</PageTitle>

<div class="account-page-wrap">
    <MudCard Elevation="6" Style="width:100%;max-width:440px">
        <MudCardContent Class="pa-8">

            <div class="d-flex flex-column align-center mb-6">
                <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead"
                         Style="font-size:3.5rem;color:#4caf50" Class="mb-2" />
                <MudText Typo="Typo.h5" Align="Align.Center"><b>Email envoyé</b></MudText>
            </div>

            <MudAlert Severity="Severity.Success" Class="mb-4">
                Si un compte est associé à cette adresse, vous recevrez un email avec un lien de réinitialisation.
            </MudAlert>

            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Align="Align.Center">
                Vérifiez votre boîte de réception et vos spams. Le lien est valable <b>1 heure</b>.
            </MudText>

            <hr class="account-divider" />

            <div class="d-flex justify-center">
                <MudLink Href="Account/Login" Color="Color.Secondary" Typo="Typo.body2">
                    ← Retour à la connexion
                </MudLink>
            </div>

        </MudCardContent>
    </MudCard>
</div>
