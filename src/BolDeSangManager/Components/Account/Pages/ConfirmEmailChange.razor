@page "/Account/ConfirmEmailChange"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BolDeSangManager.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Confirmation du changement d'email</PageTitle>

<h1>Confirmation du changement d'email</h1>

<StatusMessage Message="@message" />

@code {
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Email is null || Code is null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login", "Erreur : lien de confirmation invalide.", HttpContext);
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            message = "Erreur : compte introuvable.";
            return;
        }

        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ChangeEmailAsync(user, Email, code);
        if (!result.Succeeded)
        {
            message = "Erreur : impossible de modifier l'adresse email. Le lien a peut-être expiré ou déjà été utilisé.";
            return;
        }

        // L'email sert aussi d'identifiant de connexion : les deux doivent rester synchronisés.
        var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);
        if (!setUserNameResult.Succeeded)
        {
            message = "Erreur : impossible de mettre à jour l'identifiant de connexion.";
            return;
        }

        // Reconnexion forcée : la session courante porte l'ancien identifiant.
        await SignInManager.SignOutAsync();
        RedirectManager.RedirectToWithStatus(
            "Account/Login",
            $"Votre adresse email a bien été modifiée. Reconnectez-vous avec : {Email}",
            HttpContext);
    }
}
