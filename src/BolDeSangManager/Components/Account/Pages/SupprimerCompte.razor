@page "/compte/supprimer"
@layout BolDeSangManager.Components.Layout.MainLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using BolDeSangManager.Data
@using BolDeSangManager.Services

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject UserAccountService UserAccountService
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<SupprimerCompte> Logger

<PageTitle>Supprimer mon compte — BolDeSang Manager</PageTitle>

@* Layout MainLayout et non ManageLayout : ce dernier s'appuie sur des classes
   Bootstrap (row / col-lg-*) absentes du projet, qui est en MudBlazor. La page
   s'affichait donc en HTML brut, sans aucun style. *@

<div class="account-page-wrap">
    <MudCard Elevation="6" Style="width:100%;max-width:560px">
        <MudCardContent Class="pa-6">

            <div class="d-flex flex-column align-center mb-5">
                <MudIcon Icon="@Icons.Material.Filled.DeleteForever"
                         Color="Color.Error" Style="font-size:3rem" />
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mt-2">
                    <b>Supprimer mon compte</b>
                </MudText>
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@message</MudAlert>
            }

            @if (verdict is not null)
            {
                @if (verdict.PeutEtreSupprimeDur)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
                        <b>Votre compte sera intégralement supprimé.</b><br />
                        Aucune donnée de jeu n'y est rattachée : il ne restera rien.
                        Cette action est définitive.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                        <b>Vos données personnelles seront effacées,
                        vos résultats sportifs resteront.</b>
                    </MudAlert>

                    <MudText Typo="Typo.body2" Class="mb-2">
                        Votre compte est rattaché à :
                    </MudText>

                    <MudPaper Elevation="0" Class="pa-3 mb-3"
                              Style="background:rgba(255,255,255,0.04);border-radius:8px">
                        <MudStack Spacing="1">
                            @if (verdict.NbEquipes > 0)
                            {
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Équipes</MudText>
                                    <MudText Typo="Typo.body2"><b>@verdict.NbEquipes</b></MudText>
                                </MudStack>
                            }
                            @if (verdict.NbLigues > 0)
                            {
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Ligues que vous gérez</MudText>
                                    <MudText Typo="Typo.body2"><b>@verdict.NbLigues</b></MudText>
                                </MudStack>
                            }
                            @if (verdict.NbFeuilles > 0)
                            {
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Feuilles de match saisies</MudText>
                                    <MudText Typo="Typo.body2"><b>@verdict.NbFeuilles</b></MudText>
                                </MudStack>
                            }
                            @if (verdict.NbCommissariats > 0)
                            {
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Commissariats de ligue</MudText>
                                    <MudText Typo="Typo.body2"><b>@verdict.NbCommissariats</b></MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>

                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        Ces éléments appartiennent aussi aux autres participants : les
                        effacer viderait leurs classements. Votre e-mail, votre mot de
                        passe et votre pseudo seront effacés, et vous ne pourrez plus
                        vous connecter. Vos équipes resteront dans leurs ligues, sous
                        le nom « Coach supprimé ».
                    </MudText>
                }

                <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-4"
                          Icon="@Icons.Material.Filled.Download">
                    Avant de continuer, vous pouvez
                    <a href="/profil" class="account-link">
                        télécharger une copie de vos données</a> depuis votre profil.
                </MudAlert>
            }

            <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />

                @if (requirePassword)
                {
                    <div class="account-field">
                        <label class="account-label" for="Input.Password">Votre mot de passe</label>
                        <InputText type="password" id="Input.Password" @bind-Value="Input.Password"
                                   class="account-input" autocomplete="current-password"
                                   placeholder="••••••••" aria-required="true" />
                        <ValidationMessage For="() => Input.Password" class="account-validation-msg" />
                    </div>
                }

                <div class="account-field">
                    <label class="account-label" for="Input.Confirmation">
                        Tapez SUPPRIMER pour confirmer
                    </label>
                    <InputText id="Input.Confirmation" @bind-Value="Input.Confirmation"
                               class="account-input" autocomplete="off"
                               placeholder="SUPPRIMER" aria-required="true" />
                    <ValidationMessage For="() => Input.Confirmation" class="account-validation-msg" />
                </div>

                <MudStack Row="true" Spacing="2" Class="mt-5">
                    <MudButton Href="/profil" Variant="Variant.Outlined"
                               Color="Color.Default" FullWidth="true">
                        Annuler
                    </MudButton>
                    <button type="submit" class="account-danger-btn">
                        Supprimer définitivement
                    </button>
                </MudStack>
            </EditForm>

        </MudCardContent>
    </MudCard>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool requirePassword;
    private UserAccountService.VerdictSuppression? verdict;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        requirePassword = await UserManager.HasPasswordAsync(user);

        // Le verdict est affiché AVANT la confirmation : le coach doit savoir ce
        // qui sera réellement effacé, plutôt que de le découvrir après coup.
        verdict = await UserAccountService.EvaluerSuppressionAsync(user.Id);
    }

    private async Task OnValidSubmitAsync()
    {
        if (requirePassword && !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            message = "Mot de passe incorrect.";
            return;
        }

        if (!string.Equals(Input.Confirmation?.Trim(), "SUPPRIMER", StringComparison.Ordinal))
        {
            message = "Tapez SUPPRIMER en majuscules pour confirmer.";
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);

        // Passe par le service : il choisit entre suppression réelle et
        // anonymisation. L'appel direct à UserManager.DeleteAsync échouerait
        // pour tout coach ayant déjà une équipe ou une feuille de match.
        var result = await UserAccountService.SupprimerCompteAsync(userId, parQui: "self");
        if (!result.Succeeded)
        {
            message = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await SignInManager.SignOutAsync();
        Logger.LogInformation("Le compte {UserId} a demandé sa propre suppression.", userId);

        RedirectManager.RedirectTo("/");
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Tapez SUPPRIMER pour confirmer.")]
        public string Confirmation { get; set; } = "";
    }
}
