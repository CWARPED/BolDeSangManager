@* Les messages de statut posés par IdentityRedirectManager sont préfixés
   « Error: » côté framework ; on traduit et on rend en MudAlert. *@
@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var estErreur = DisplayMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase)
                    || DisplayMessage.StartsWith("Erreur", StringComparison.OrdinalIgnoreCase);
    var texte = estErreur
        ? System.Text.RegularExpressions.Regex.Replace(DisplayMessage, @"^Error\s*:\s*", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase)
        : DisplayMessage;

    <MudAlert Severity="@(estErreur ? Severity.Error : Severity.Success)"
              Dense="true" Class="mb-4">
        @texte
    </MudAlert>
}

@code {
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
