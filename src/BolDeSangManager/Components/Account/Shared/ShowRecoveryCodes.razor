<StatusMessage Message="@StatusMessage" />

<MudText Typo="Typo.h6" Class="mb-3"><b>Codes de secours</b></MudText>

<MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
    <b>Conservez ces codes en lieu sûr.</b><br />
    Sans eux, la perte de votre téléphone vous ferait perdre l'accès à votre compte.
    Chaque code n'est utilisable qu'une seule fois.
</MudAlert>

<MudPaper Elevation="0" Class="pa-3" Style="background:rgba(255,255,255,0.04);border-radius:8px">
    <div class="recovery-codes-grid">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <code class="recovery-code">@recoveryCode</code>
        }
    </div>
</MudPaper>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
