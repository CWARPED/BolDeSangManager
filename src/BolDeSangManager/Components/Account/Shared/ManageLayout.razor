@inherits LayoutComponentBase
@layout BolDeSangManager.Components.Layout.MainLayout

@* Layout des pages « Mon compte ». Il s'appuyait sur des classes Bootstrap
   (row / col-lg-*) absentes du projet, qui est en MudBlazor : toutes les pages
   Identity tombaient en HTML brut. Reconstruit en MudGrid. *@

<MudText Typo="Typo.h5" Class="mb-4"><b>Mon compte</b></MudText>

<MudGrid Spacing="4">
    <MudItem xs="12" md="3">
        <ManageNavMenu />
    </MudItem>
    <MudItem xs="12" md="9">
        <MudPaper Elevation="2" Class="pa-4 pa-sm-6">
            @Body
        </MudPaper>
    </MudItem>
</MudGrid>
