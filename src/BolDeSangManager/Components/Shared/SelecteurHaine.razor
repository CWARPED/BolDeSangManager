@* #28 — « Prendre sa revanche » (LRB S3 p.42) : sur Amoché, Blessure sérieuse
   ou Séquelle, un 4+ au D6 donne Haine (X). Champ TEXTE libre, avec en
   suggestion les mots-clés de la version : il marche donc aussi en Dungeon
   Bowl, que le catalogue ait des Traits « Haine (…) » ou non.
   Partagé par la saisie de la feuille, la correction commissaire et l'édition
   d'un joueur sur la page de l'équipe : le même champ partout.

   ⚠️ Pas de MudAutocomplete : sa liste ouverte pose un calque invisible qui
   AVALE le clic suivant (le ✓ de validation, « Enregistrer la feuille ») —
   il fallait cliquer deux fois. Les suggestions passent par un <datalist>
   natif, sans calque, qui marche aussi au doigt. *@

<MudTextField @key="_generation" @ref="_champ" T="string" Value="Value" ValueChanged="ValueChanged" Immediate="true"
              Label="@Label" Placeholder="@Placeholder" MaxLength="60"
              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
              AutoFocus="AutoFocus" Class="@Class" Style="min-width:160px"
              UserAttributes="_attributs" OnKeyDown="SurTouche" />
<datalist id="@_id">
    @foreach (var s in Suggestions)
    {
        <option value="@s"></option>
    }
</datalist>

@code {
    [Parameter] public IReadOnlyList<string> Suggestions { get; set; } = [];
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Haine gagnée (jet 4+)";
    [Parameter] public string Placeholder { get; set; } = "ex. Orque";
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>Touche Entrée : valider sans aller chercher le bouton.</summary>
    [Parameter] public EventCallback OnEntree { get; set; }

    readonly string _id = $"haines-{Guid.NewGuid():N}";
    Dictionary<string, object> _attributs = [];
    MudTextField<string>? _champ;
    int _generation;
    bool _refocus;

    protected override void OnInitialized() =>
        _attributs = new() { ["list"] = _id, ["autocomplete"] = "off" };

    /// <summary>
    /// Vide le champ À L'ÉCRAN et lui rend le focus, pour enchaîner une autre
    /// saisie. Ni remettre <c>Value</c> à null, ni <c>MudTextField.Clear()</c>
    /// ne vident un champ qui a le focus (validation par Entrée) : le texte
    /// restait affiché et la saisie suivante s'y accolait (« OrqueNain »).
    /// Changer la clé recrée l'input, vide par construction.
    /// </summary>
    public Task ViderAsync()
    {
        _generation++;
        _refocus = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_refocus && _champ is not null)
        {
            _refocus = false;
            await _champ.FocusAsync();
        }
    }

    async Task SurTouche(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && OnEntree.HasDelegate)
            await OnEntree.InvokeAsync();
    }
}
