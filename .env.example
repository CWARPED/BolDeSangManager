# Copier ce fichier en .env (gitignored) puis remplir les valeurs.

# ── Admin initial (cree au premier demarrage si la base est vide) ─────────────
BolDeSang__AdminEmail=admin@example.com
BolDeSang__AdminPassword=ChangeMe123!

# ── Deploiement NAS avec nginx-proxy + Let's Encrypt ──────────────────────────
# Hostname public sur lequel l'app est accessible (doit pointer vers ton IP).
PUBLIC_HOSTNAME=boldesang.example.com

# Email utilise par Let's Encrypt pour les notifications de renouvellement.
LETSENCRYPT_EMAIL=admin@example.com
